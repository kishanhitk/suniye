---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="Suniye Blog — Dictation on macOS, Compared"
  description="Honest comparisons and guides on private, on-device dictation for macOS — how Suniye stacks up against cloud-based tools, and how local speech recognition actually works."
  canonicalPath="/blogs"
>
  <Navbar variant="subpage" />

  <main class="mx-auto max-w-3xl px-6 pb-24 pt-28">
    <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-4 text-lg text-muted">
      Comparisons and guides on dictation for macOS — written from the inside of an
      open-source, local-first app, so the claims about ours are checkable against the code.
    </p>

    <ul class="mt-12 divide-y divide-border border-y border-border">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/blogs/${post.id}`} class="group block">
            <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-widest text-muted/70">
              <time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.category === "comparison" ? "Comparison" : "Guide"}</span>
            </div>
            <h2 class="mt-2 font-display text-xl tracking-tight text-ink transition-colors group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="mt-12 text-muted">Nothing published yet.</p>
    )}
  </main>

  <Footer current="/blogs" />
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export const prerender = false;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

// publishDate/updatedDate are date-only values (midnight UTC once Zod coerces
// them), so formatting has to pin UTC too — otherwise a build running in a
// negative UTC offset renders the day before whatever's in the frontmatter.
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Layout
  title="Suniye Blog — Dictation on macOS, Compared"
  description="Honest comparisons and guides on private, on-device dictation for macOS — how Suniye stacks up against cloud-based tools, and how local speech recognition actually works."
  canonicalPath="/blogs"
>
  <Navbar variant="subpage" />

  <main class="relative mx-auto max-w-3xl overflow-hidden px-6 pb-24 pt-28">
    <div class="bloom left-[-12rem] top-[-4rem] h-[20rem] w-[28rem]" aria-hidden="true"></div>
    <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-4 text-lg text-muted">
      Comparisons and guides on dictation for macOS, from the team building Suniye.
    </p>

    <ul class="mt-12 divide-y divide-border border-y border-border">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/blogs/${post.id}`} class="group block">
            <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-widest text-muted/70">
              <time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.category === "comparison" ? "Comparison" : "Guide"}</span>
            </div>
            <h2 class="mt-2 font-display text-xl tracking-tight text-ink transition-colors group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="mt-12 text-muted">Nothing published yet.</p>
    )}
  </main>

  <Footer current="/blogs" />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  PRIVACY_META,
  PRIVACY_HEADLINE,
  PRIVACY_INTRO,
  COLLECTED,
  NEVER_COLLECTED,
  HOW_IT_STAYS_PRIVATE,
  WEBSITE_ANALYTICS,
  emphasisToHtml,
} from "../lib/content/privacy";

// On demand so `Accept: text/markdown` reaches the middleware (see index.astro).
export const prerender = false;
---

<Layout title={PRIVACY_META.title} description={PRIVACY_META.description} canonicalPath="/privacy">
  <Navbar variant="subpage" />

  <main class="mx-auto max-w-3xl px-6 pb-24 pt-28">
    <h1 class="font-display text-3xl tracking-tight sm:text-4xl">{PRIVACY_HEADLINE}</h1>
    <p class="mt-4 text-lg text-muted" set:html={emphasisToHtml(PRIVACY_INTRO)} />

    <section class="mt-12">
      <h2 class="font-display text-xl tracking-tight">What we collect</h2>
      <dl class="mt-5 space-y-4">
        {COLLECTED.map(([term, detail]) => (
          <div class="rounded-xl border border-border/60 bg-white/40 p-5">
            <dt class="text-base text-ink">{term}</dt>
            <dd class="mt-1 text-sm text-muted">{detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-xl tracking-tight">What we never collect</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {NEVER_COLLECTED.map((item) => (
          <li class="rounded-lg border border-border/60 px-3 py-1.5 text-sm text-muted line-through decoration-red-400/70">
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12 space-y-4 text-sm text-muted">
      <h2 class="font-display text-xl tracking-tight text-ink">How it stays private</h2>
      {HOW_IT_STAYS_PRIVATE.map((paragraph) => (
        <p set:html={emphasisToHtml(paragraph)} />
      ))}
    </section>

    <section class="mt-12 space-y-4 text-sm text-muted">
      <h2 class="font-display text-xl tracking-tight text-ink">Website analytics</h2>
      <p set:html={emphasisToHtml(WEBSITE_ANALYTICS)} />
    </section>
  </main>

  <Footer current="/privacy" />
</Layout>

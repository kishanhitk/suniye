---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_PAGES } from "../lib/site";

// On demand so the middleware can answer agents with a Markdown 404 body.
export const prerender = false;

const recovery = [
  { href: "/sitemap.xml", label: "Sitemap", summary: "Every indexable URL on this site." },
  { href: "/llms.txt", label: "llms.txt", summary: "What Suniye is, when to use it, and how agents should read this site." },
];
---

<Layout title="Page not found — Suniye" description="There is no page at this address. Here is where to look instead." noindex>
  <Navbar variant="subpage" />

  <main class="mx-auto max-w-3xl px-6 pb-24 pt-28">
    <p class="font-mono text-[11px] uppercase tracking-widest text-muted/70">404</p>
    <h1 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-lg text-muted">
      There is no page at <code class="rounded bg-surface px-1.5 py-0.5 font-mono text-[0.9em] text-ink">{Astro.url.pathname}</code>.
      Here is where to look instead.
    </p>

    <ul class="mt-10 divide-y divide-border border-y border-border">
      {[...SITE_PAGES.map((p) => ({ href: p.path, label: p.title, summary: p.summary })), ...recovery].map((item) => (
        <li class="py-4">
          <a href={item.href} class="group block">
            <span class="font-display text-lg text-ink transition-colors group-hover:text-accent">{item.label}</span>
            <span class="mt-0.5 block text-sm text-muted">{item.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>

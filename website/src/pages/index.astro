        </div>
      </div>
    </section>

    <!-- ── Closing ──────────────────────────── -->
    <!-- Book-ends the hero with the quieter dawn painting, so the page opens and
         closes on the same idea instead of trailing off into chrome. -->
    <section class="relative overflow-hidden bg-[#dfe9f4]">
      <picture>
        <source srcset="/band-dawn.webp" type="image/webp" />
        <img src="/band-dawn.jpg" alt="" loading="lazy" decoding="async" class="hero-art" />
      </picture>

      <div class="relative z-10 mx-auto max-w-6xl px-6 py-28 text-center md:py-36">
        <h2 class="on-art font-display text-3xl leading-snug tracking-tight md:text-5xl">
          Your voice, your machine.
        </h2>
        <div class="mt-8 flex justify-center">
          <a
            href={downloadUrl}
            data-dmg
            data-track="download_click:dmg_footer"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>
      </div>
    </section>

    <!-- ── Quarantine notice — surfaced after a .dmg download ─ -->
    <div
      id="dmg-banner"
      class="dmg-modal fixed inset-0 z-[70] flex items-center justify-center px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dmg-title"
    >
      <div class="dmg-scrim absolute inset-0 bg-ink/55" data-dmg-close></div>

      <div class="dmg-card relative w-full max-w-2xl overflow-hidden rounded-2xl border border-white/70 bg-bg shadow-[0_50px_120px_-24px_rgba(16,40,68,0.55)]">
        <div class="p-7 md:p-8">
          <div class="flex items-start gap-4">
            <div class="flex-1">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted/60">
                One-time step
              </p>
              <p id="dmg-title" class="mt-2 font-display text-2xl leading-tight tracking-tight text-ink">
                If macOS says the app is damaged
              </p>
            </div>
            <button
              id="dmg-banner-close"
              type="button"
              class="btn-press -mr-1.5 -mt-1.5 flex-none rounded-lg p-2 text-muted/50 hover:bg-surface hover:text-ink"
              aria-label="Dismiss"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-muted">
            It isn't. Suniye isn't signed with a paid Apple Developer certificate,
            so macOS quarantines the download. This clears it:
          </p>

          <!-- The command reads as a terminal line, not a form field: dark ground,
               mono, and the only thing in the dialog with any weight. -->
          <div class="mt-5 flex items-center gap-3 rounded-xl bg-ink px-4 py-3.5">
            <code class="flex-1 break-all font-mono text-[12.5px] leading-relaxed text-white/90">
              {quarantineCmd}
            </code>
            <button
              class="copy-btn btn-press relative flex-none rounded-md p-1.5 text-white/50 hover:bg-white/10 hover:text-white"
              data-copy={quarantineCmd}
              aria-label="Copy the command"
            >
              <svg class="copy-icon h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
              </svg>
              <svg class="check-icon h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>

          <p class="mt-3 text-[13px] leading-relaxed text-muted/75">
            Paste it into Terminal after dragging Suniye to Applications, then open
            the app as usual.
          </p>
        </div>

        <!-- Homebrew avoids the whole thing, so it belongs here rather than buried
             further down the page. Deliberately quieter than the xattr block
             above: light ground, muted ink, no terminal styling — an alternative
             for next time, not a second instruction competing with the fix. -->
        <div class="border-t border-border bg-surface/70 px-7 py-5 md:px-8">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
            <div class="min-w-0 flex-1">
              <p class="text-[13px] leading-relaxed text-muted">
                Or install with Homebrew, which clears this for you.
              </p>
              <button
                class="copy-btn btn-press relative mt-2 flex w-full items-center gap-2 rounded-lg border border-border bg-bg px-3 py-2 text-left"
                data-copy={brewInstall}
                data-track="download_click:homebrew_modal"
                aria-label="Copy the Homebrew install command"
              >
                <code class="min-w-0 flex-1 break-all font-mono text-[12px] text-muted">
                  {brewInstall}
                </code>
                <span class="relative h-3.5 w-3.5 flex-none text-muted/50">
                  <svg class="copy-icon h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
                  </svg>
                  <svg class="check-icon h-3.5 w-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>

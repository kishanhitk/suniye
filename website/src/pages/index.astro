    </section>

    <!-- ── FAQ ──────────────────────────────── -->
    <section id="faq" class="band scroll-mt-20 bg-[linear-gradient(180deg,transparent,rgba(43,108,196,0.05))]">
      <div class="band-inner">
        <p class="rail reveal">Questions</p>

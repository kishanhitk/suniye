---
import Layout from "../layouts/Layout.astro";
import CopyField from "../components/CopyField.astro";
import Navbar from "../components/Navbar.astro";
import { softwareApplicationSchema, faqPageSchema, jsonLdString } from "../lib/seo";

const githubUrl = "https://github.com/kishanhitk/suniye";
const downloadUrl = "https://github.com/kishanhitk/suniye/releases/latest/download/Suniye.dmg";
const brewInstall = "brew install --cask kishanhitk/tap/suniye";
const quarantineCmd = "xattr -rd com.apple.quarantine /Applications/Suniye.app";

// The whole argument in two paths. Deliberately structural rather than
// benchmarked: "no round trip" is true by construction, a millisecond figure
// would need a measurement this page can't show.
const cloudPath = [
  "You speak",
  "Your audio is uploaded",
  "A server transcribes it",
  "The text travels back",
];
const localPath = ["You speak", "Your Mac transcribes it", "The text is at your cursor"];

const pillars = [
  {
    title: "Works where you type",
    desc: "Mail, Slack, Notes, your editor, your browser. The text lands at the cursor and your clipboard is left exactly as you had it.",
  },
  {
    title: "Choose how it listens",
    desc: "Swap the speech model to suit your Mac — small and quick, or large and exacting. Apple's built-in engine needs no download at all.",
  },
  {
    title: "Cleanup that stays home",
    desc: "Optional Magic Format tidies grammar and punctuation using Apple Intelligence or a model on your Mac. Off until you turn it on.",
  },
  {
    title: "Free, and readable",
    desc: "MIT licensed, no account, no subscription, no third-party tracking. Every line is on GitHub if you want to check the claims yourself.",
  },
];

// Mirrors the in-app catalog (ASRModelCatalog.swift). Kept behind a disclosure:
// the fact that you get a choice is the point, the eleven rows are reference.
const models = [
  { name: "Apple Speech", langs: "Follows your system language", size: "Built in", tag: "macOS 26+" },
  { name: "Parakeet TDT 0.6B v3", langs: "25 European languages", size: "~680 MB", tag: "Recommended" },
  { name: "Parakeet TDT 0.6B v2", langs: "English", size: "~482 MB", tag: null },
  { name: "SenseVoice", langs: "Chinese · English · Japanese · Korean · Cantonese", size: "~240 MB", tag: null },
  { name: "Moonshine Base", langs: "English", size: "~285 MB", tag: null },
  { name: "Whisper Large v3 Turbo", langs: "Multilingual", size: "~564 MB", tag: null },
  { name: "Whisper Distil Large v3", langs: "Multilingual", size: "~529 MB", tag: null },
  { name: "Whisper Large v3", langs: "Multilingual", size: "~1.7 GB", tag: null },
  { name: "Whisper Small (English)", langs: "English", size: "~636 MB", tag: null },
  { name: "Whisper Base (English)", langs: "English", size: "~209 MB", tag: null },
  { name: "Whisper Tiny (English)", langs: "English", size: "~118 MB", tag: null },
];

const faqs = [
  {
    q: "Is my dictation really private?",
    a: "Your voice is captured and turned into text entirely on your Mac — the audio never touches the internet. Suniye does send a small amount of pseudonymous usage data (counts and timings, never your words), which you can switch off in Settings → Privacy; the privacy page lists exactly what is collected. Otherwise it goes online only to check for updates and to download a model the first time.",
  },
  {
    q: "Does the optional AI cleanup see my audio?",
    a: "Never. Cleanup only ever works on the text. By default it runs on your Mac, using Apple Intelligence or a local model. Only if you deliberately turn on the online option does your text reach a provider you chose — and it is off by default.",
  },
  {
    q: "Does it work offline?",
    a: "Yes. Once a model is downloaded, dictation needs no connection at all — including on a plane. The only things that use the network are update checks, the opt-out usage stats, and the online cleanup provider if you enable it.",
  },
  {
    q: "What languages can it understand?",
    a: "It depends on the model you pick. Some cover 25 European languages, others handle Chinese, Japanese, Korean, English and Cantonese, and the largest understand a broad mix. Several English-only models are smaller and faster.",
  },
  {
    q: "Why does macOS say the app is damaged?",
    a: "Only the direct .dmg download is affected. Suniye is not signed with a paid Apple Developer certificate, so macOS quarantines it on first launch. Run the xattr command shown above once to clear it — or install with Homebrew, which does it for you.",
  },
  {
    q: "Is it free?",
    a: "Completely. Free and open source under the MIT license. No subscription, no account, no third-party tracking.",
  },
];
---

<Layout>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(softwareApplicationSchema())}
  />
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(faqPageSchema(faqs))}
  />
  <link slot="head" rel="preload" as="image" href="/hero.webp" type="image/webp" />

  <Navbar variant="over-art" />

  <!-- With JS off, reveal-on-scroll never fires — show everything up front. -->
  <noscript>
    <style>
      .reveal, .fade-in { opacity: 1 !important; transform: none !important; animation: none !important; }
    </style>
  </noscript>

  <main>
    <!-- ── Hero ─────────────────────────────── -->
    <!-- The painting is the page's whole first impression, so it is a real <img>
         (decoding early, preloaded) rather than a CSS background: the browser
         can then prioritise it as the LCP element. -->
    <section class="relative flex min-h-[100svh] flex-col overflow-hidden bg-[#2b6cc4]">
      <picture>
        <source
          srcset="/hero-sm.webp 1100w, /hero.webp 2000w"
          sizes="100vw"
          type="image/webp"
        />
        <img
          src="/hero.jpg"
          srcset="/hero-sm.jpg 1100w, /hero.jpg 2000w"
          sizes="100vw"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="hero-art"
        />
      </picture>

      <div class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-6 pt-28 pb-[38vh] text-center">
        <h1 class="on-art font-display text-[clamp(2.75rem,6.6vw,5rem)] font-medium leading-[1.02] tracking-[-0.02em]">
          Speak freely.
        </h1>

        <p class="on-art-muted fade-in mx-auto mt-5 max-w-[34em] text-[17px] leading-relaxed">
          The cloud has to hear you before it can type. Suniye doesn't — the model
          runs on your Mac, so the words land as fast as you say them, and your
          voice never leaves the machine.
        </p>

        <div class="fade-in mt-7 flex justify-center">
          <a
            href={downloadUrl}
            data-dmg
            data-track="download_click:dmg"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>

        <p class="on-art-muted fade-in mt-3 text-[11px]">
          Apple Silicon &middot; macOS 14+ &middot; Open source
        </p>
      </div>
    </section>

    <!-- Nav skin swaps when this passes the top of the viewport. -->
    <div id="nav-sentinel" aria-hidden="true"></div>

    <!-- ── The argument ─────────────────────── -->
    <section class="py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl leading-snug tracking-tight md:text-4xl">
            Every other dictation app sends your voice away.
          </h2>
          <p class="mt-4 leading-relaxed text-muted">
            They are built on someone else's API, so your audio has to travel there
            and back before a single word appears. That round trip is the wait — and
            the privacy question.
          </p>
        </div>

        <div class="reveal mt-14 grid gap-6 md:grid-cols-2" style="transition-delay: 0.1s">
          <!-- Cloud path — deliberately the longer, greyer column. -->
          <div class="card border-border/70 bg-surface/60 p-7">
            <p class="font-mono text-[11px] uppercase tracking-widest text-muted/70">
              Cloud dictation
            </p>
            <ol class="mt-5 space-y-3">
              {cloudPath.map((step, i) => (
                <li class="flex items-start gap-3 text-[15px] text-muted">
                  <span class="mt-[3px] font-mono text-[11px] tabular-nums text-muted/50">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
            <p class="mt-6 border-t border-border/70 pt-4 text-sm text-muted/80">
              Needs a connection. Your voice sits, however briefly, on a disk you
              don't own.
            </p>
          </div>

          <!-- Local path — shorter by one step, and the only coloured surface here. -->
          <div class="card border-accent/30 bg-accent/[0.04] p-7">
            <p class="font-mono text-[11px] uppercase tracking-widest text-accent">
              Suniye
            </p>
            <ol class="mt-5 space-y-3">
              {localPath.map((step, i) => (
                <li class="flex items-start gap-3 text-[15px] text-ink">
                  <span class="mt-[3px] font-mono text-[11px] tabular-nums text-accent/60">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  {step}
                </li>
              ))}
            </ol>
            <p class="mt-6 border-t border-accent/20 pt-4 text-sm text-muted">
              Works on a plane. Nothing to upload, so there is nothing to keep.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Demo ─────────────────────────────── -->
    <!-- Click-to-play with sound: the narration is the point, and browsers block
         autoplay-with-audio, so we lead with a poster and a play affordance. -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl leading-snug tracking-tight md:text-4xl">
            Hold a key. Talk. Let go.
          </h2>
          <p class="mt-4 leading-relaxed text-muted">
            That is the entire interface. Default is Fn/Globe; make it any shortcut
            you like.
          </p>
        </div>

        <figure class="reveal mt-12" style="transition-delay: 0.1s">
          <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-border bg-surface shadow-[var(--shadow-float)]">
            <div class="flex items-center gap-1.5 border-b border-border/70 bg-surface/70 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="ml-2.5 flex items-center gap-1.5 font-mono text-[11px] tracking-tight text-muted/70">
                <img src="/suniye-icon.png" alt="" class="h-3.5 w-3.5 rounded-[3px]" />
                Suniye
              </span>
            </div>

            <div class="relative bg-ink">
              <video
                id="demo-video"
                class="block w-full"
                poster="/demo-poster.jpg"
                preload="metadata"
                playsinline
                data-track-video
              >
                <source src="/demo.mp4" type="video/mp4" />
                Your browser can't play this video.
                <a href="/demo.mp4" class="underline">Download the demo</a> instead.
              </video>

              <!-- Live stopwatch, synced to the real playback clock -->
              <div
                id="demo-timer"
                class="pointer-events-none absolute right-3 top-3 z-20 rounded-md bg-ink/70 px-2.5 py-1 font-mono text-xs tabular-nums tracking-tight text-white backdrop-blur-sm"
                aria-hidden="true"
              >
                00:00.000
              </div>

              <button
                id="demo-play"
                type="button"
                class="demo-play group absolute inset-0 flex items-center justify-center bg-ink/25 transition-opacity duration-300"
                aria-label="Play the demo with sound"
              >
                <span
                  class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-accent text-white shadow-xl ring-1 ring-white/10 transition-transform duration-150 [transition-timing-function:var(--curve-out)] group-hover:scale-105 group-active:scale-95 md:h-[88px] md:w-[88px]"
                >
                  <svg class="h-7 w-7 translate-x-[2px] md:h-9 md:w-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 4.5l13 7.5-13 7.5z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <figcaption class="mt-4 text-center font-mono text-xs tracking-wide text-muted/60">
            A real, unedited take.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ── What you get ─────────────────────── -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
          {pillars.map((p, i) => (
            <div class="reveal" style={`transition-delay: ${i * 0.06}s`}>
              <h3 class="font-display text-xl tracking-tight">{p.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Models ───────────────────────────── -->
    <!-- The choice is the selling point; the catalogue is reference, so it stays
         folded until someone actually wants to compare sizes. -->
    <section id="models" class="scroll-mt-20 border-t border-border/60 bg-surface/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl leading-snug tracking-tight md:text-4xl">
            Eleven ways to listen.
          </h2>
          <p class="mt-4 leading-relaxed text-muted">
            From a 118 MB model that keeps up on any Mac to a 1.7 GB one that
            catches everything — plus Apple's built-in engine, which downloads
            nothing at all. Switch whenever you like; they all run locally.
          </p>
        </div>

        <details class="reveal group mx-auto mt-10 max-w-3xl" style="transition-delay: 0.1s">
          <summary class="mx-auto flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-bg px-5 py-2.5 font-mono text-xs tracking-wide text-muted transition-colors [&::-webkit-details-marker]:hidden hover:text-ink">
            <span class="group-open:hidden">See every model</span>
            <span class="hidden group-open:inline">Hide the list</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-200 [transition-timing-function:var(--curve-out)] group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <ul class="mt-8 divide-y divide-border/70 border-y border-border/70">
            {models.map((m) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3.5">
                <span class="text-[15px] tracking-tight text-ink">{m.name}</span>
                {m.tag && <span class="pill pill-accent">{m.tag}</span>}
                <span class="ml-auto font-mono text-xs text-muted/70">{m.size}</span>
                <span class="w-full text-sm text-muted/80">{m.langs}</span>
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>

    <!-- ── Install ──────────────────────────── -->
    <section id="install" class="scroll-mt-20 border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal mx-auto max-w-xl">
          <h2 class="text-center font-display text-3xl tracking-tight md:text-4xl">
            Install it
          </h2>

          <div class="mt-8">
            <div class="mb-2 flex items-center justify-center gap-2">
              <span class="font-mono text-xs uppercase tracking-widest text-muted">
                Homebrew
              </span>
              <span class="pill pill-accent">Recommended</span>
            </div>
            <CopyField
              value={brewInstall}
              label="Copy install command"
              dataTrack="download_click:homebrew"
            />
            <p class="mt-3 text-center text-sm text-muted/80">
              Homebrew clears the macOS quarantine for you. It will ask you to trust
              the tap first — that is Homebrew 6 asking about any third-party tap,
              not something specific to Suniye.
            </p>
          </div>

          <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
            <a
              href={downloadUrl}
              data-dmg
              data-track="download_click:dmg"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm text-ink hover:bg-surface"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3" />
              </svg>
              Download .dmg
            </a>
            <a
              href={`${githubUrl}#build-from-source`}
              target="_blank"
              rel="noopener"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm text-ink hover:bg-surface"
            >
              Build from source
            </a>
          </div>

          <p class="mt-8 text-center text-sm text-muted/80">
            macOS 14 (Sonoma) or later. Dictation works on Intel and Apple Silicon;
            the on-device cleanup model needs Apple Silicon.
          </p>

          <p class="mt-6 text-center">
            <span class="pill pill-accent">Alpha — expect rough edges</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────── -->
    <section id="faq" class="scroll-mt-20 border-t border-border/60 bg-surface/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.6fr] lg:gap-16">
          <h2 class="reveal font-mono text-sm uppercase tracking-widest text-muted lg:sticky lg:top-28 lg:self-start">
            Questions
          </h2>

          <div class="reveal divide-y divide-border/70 border-y border-border/70" style="transition-delay: 0.1s">
            {faqs.map((item) => (
              <details class="faq-item group">
                <summary class="flex items-center justify-between gap-4 py-5">
                  <span class="text-base tracking-tight text-ink">{item.q}</span>
                  <span class="faq-sign shrink-0 text-xl leading-none text-accent">+</span>
                </summary>
                <p class="pb-5 text-[15px] leading-relaxed text-muted">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Closing ──────────────────────────── -->
    <!-- Book-ends the hero with the quieter dawn painting, so the page opens and
         closes on the same idea instead of trailing off into chrome. -->
    <section class="relative overflow-hidden bg-[#dfe9f4]">
      <picture>
        <source srcset="/band-dawn.webp" type="image/webp" />
        <img src="/band-dawn.jpg" alt="" loading="lazy" decoding="async" class="hero-art" />
      </picture>

      <div class="relative z-10 mx-auto max-w-6xl px-6 py-28 text-center md:py-36">
        <h2 class="on-art font-display text-3xl leading-snug tracking-tight md:text-5xl">
          Your voice, your machine.
        </h2>
        <div class="mt-8 flex justify-center">
          <a
            href={downloadUrl}
            data-dmg
            data-track="download_click:dmg_footer"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            Download for macOS
          </a>
        </div>
      </div>
    </section>

    <!-- ── Quarantine notice — surfaced after a .dmg download ─ -->
    <div
      id="dmg-banner"
      class="dmg-modal fixed inset-0 z-[70] flex items-center justify-center px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dmg-title"
    >
      <div class="dmg-scrim absolute inset-0 bg-ink/45 backdrop-blur-sm" data-dmg-close></div>

      <div class="dmg-card relative w-full max-w-md overflow-hidden rounded-2xl border border-border bg-bg p-6 shadow-[0_50px_120px_-24px_rgba(18,35,61,0.55)]">
        <div class="flex items-start gap-3">
          <p id="dmg-title" class="flex-1 font-display text-lg leading-snug tracking-tight text-ink">
            Clear quarantine if macOS blocks it
          </p>
          <button
            id="dmg-banner-close"
            type="button"
            class="btn-press -mt-0.5 flex-none rounded-md p-1 text-muted/50 hover:bg-surface hover:text-ink"
            aria-label="Dismiss"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>

        <p class="mt-2 text-sm leading-relaxed text-muted">
          Suniye isn't signed with a paid Apple Developer certificate, so macOS
          quarantines the .dmg. Run this once to remove it.
        </p>

        <CopyField value={quarantineCmd} label="Copy command" class="mt-4" />

        <div class="mt-5 flex justify-end">
          <button
            type="button"
            data-dmg-close
            class="btn-press rounded-lg bg-ink px-5 py-2.5 text-sm text-bg hover:bg-ink/85"
          >
            Got it
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- ── Footer ─────────────────────────────── -->
  <footer class="border-t border-border/60 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 md:flex-row">
      <div class="flex items-center gap-2.5">
        <img src="/suniye-icon.png" alt="" class="h-5 w-5 rounded-[3px]" />
        <span class="text-sm text-muted">Suniye &middot; MIT License</span>
      </div>
      <div class="flex items-center gap-6 text-sm text-muted">
        <a href={githubUrl} target="_blank" rel="noopener" data-track="outbound_click:github" class="transition-colors hover:text-ink">
          GitHub
        </a>
        <a href={`${githubUrl}/issues`} target="_blank" rel="noopener" class="transition-colors hover:text-ink">
          Issues
        </a>
        <a href="/changelog" class="transition-colors hover:text-ink">Changelog</a>
        <a href="/privacy" class="transition-colors hover:text-ink">Privacy</a>
      </div>
    </div>
  </footer>

  <!-- ── Behaviour ──────────────────────────── -->
  <script>
    const revealEls = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      // No observer support — reveal everything rather than leave it hidden.
      revealEls.forEach((el) => el.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      revealEls.forEach((el) => observer.observe(el));
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Demo video: click the poster overlay to play with sound and native controls,
    // and run a stopwatch read from the real playback clock. Under reduced motion
    // we drop the 60fps millisecond repaint and tick on the video's own updates.
    const demoVideo = document.getElementById("demo-video");
    const demoPlay = document.getElementById("demo-play");
    const demoTimer = document.getElementById("demo-timer");
    if (demoVideo && demoPlay) {
      const fmt = (t) => {
        const base =
          String(Math.floor(t / 60)).padStart(2, "0") + ":" +
          String(Math.floor(t % 60)).padStart(2, "0");
        if (reduceMotion) return base;
        return base + "." + String(Math.floor((t % 1) * 1000)).padStart(3, "0");
      };
      const render = () => {
        if (demoTimer) demoTimer.textContent = fmt(demoVideo.currentTime);
      };
      let raf = 0;
      const tick = () => {
        render();
        raf = requestAnimationFrame(tick);
      };
      render();
      demoVideo.addEventListener("play", () => {
        if (reduceMotion) return;
        cancelAnimationFrame(raf);
        tick();
      });
      demoVideo.addEventListener("pause", () => {
        cancelAnimationFrame(raf);
        render();
      });
      demoVideo.addEventListener("seeked", render);
      if (reduceMotion) demoVideo.addEventListener("timeupdate", render);
      demoPlay.addEventListener("click", () => {
        demoVideo.controls = true;
        demoPlay.classList.add("is-playing");
        demoVideo.play().catch(() => {
          demoPlay.classList.remove("is-playing");
          demoVideo.controls = false;
        });
      });
      demoVideo.addEventListener("ended", () => {
        cancelAnimationFrame(raf);
        render();
        demoVideo.controls = false;
        demoPlay.classList.remove("is-playing");
      });
    }

    // Surface the quarantine notice once the user grabs the app directly.
    // As an aria-modal dialog it owns focus while open: move focus in, trap Tab,
    // lock body scroll, and restore focus to the trigger on close.
    const dmgBanner = document.getElementById("dmg-banner");
    if (dmgBanner) {
      const card = dmgBanner.querySelector(".dmg-card");
      const closeEl = document.getElementById("dmg-banner-close");
      let lastFocused = null;
      const openDmg = () => {
        lastFocused = document.activeElement;
        dmgBanner.classList.add("is-open");
        document.body.style.overflow = "hidden";
        closeEl?.focus();
      };
      const closeDmg = () => {
        dmgBanner.classList.remove("is-open");
        document.body.style.overflow = "";
        lastFocused?.focus?.();
      };
      document.querySelectorAll("[data-dmg]").forEach((el) => {
        el.addEventListener("click", openDmg);
      });
      dmgBanner
        .querySelectorAll("[data-dmg-close], #dmg-banner-close")
        .forEach((el) => el.addEventListener("click", closeDmg));
      document.addEventListener("keydown", (e) => {
        if (!dmgBanner.classList.contains("is-open")) return;
        if (e.key === "Escape") {
          closeDmg();
        } else if (e.key === "Tab" && card) {
          const items = card.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Copy the command associated with each copy button to the clipboard.
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text =
          btn.getAttribute("data-copy") ||
          btn.parentElement?.querySelector("code")?.textContent?.trim() ||
          "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 2000);
        } catch {
          // Clipboard API unavailable (e.g. insecure context) — fail silently.
        }
      });
    });
  </script>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import CopyField from "../components/CopyField.astro";
import Navbar from "../components/Navbar.astro";

const heroWords = "Your voice. Your machine. Your text.".split(" ");
const githubUrl = "https://github.com/kishanhitk/suniye";
const downloadUrl = "https://github.com/kishanhitk/suniye/releases/latest/download/Suniye.dmg";
const brewInstall = "brew install --cask kishanhitk/tap/suniye";
const quarantineCmd = "xattr -rd com.apple.quarantine /Applications/Suniye.app";




const steps = [
  {
    num: "01",
    title: "Hold your hotkey",
    desc: "Press and hold Fn/Globe — or any shortcut you choose. A small indicator pops up.",
  },
  {
    num: "02",
    title: "Speak naturally",
    desc: "Talk at your normal pace. Your voice is captured through your mic and stays on your Mac.",
  },
  {
    num: "03",
    title: "Text appears",
    desc: "Release the key. Your words turn into text on your Mac and appear at your cursor.",
  },
];

const features = [
  {
    title: "Runs on your Mac",
    desc: "Speech recognition happens entirely on your Mac. Choose from a built-in library of models — no internet needed to turn your voice into text. No server. No cloud.",
  },
  {
    title: "Instant results",
    desc: "No trip to the cloud. Your voice becomes text in an instant — the model is always loaded and ready to go.",
  },
  {
    title: "Works in any app",
    desc: "Your words appear right at your cursor — Mail, Slack, Notes, your browser, your editor. Everywhere you type.",
  },
  {
    title: "AI cleanup, on your Mac",
    desc: "Optional cleanup tidies grammar and punctuation using Apple's built-in AI or a model on your Mac — no cloud needed. Or connect your own provider. Off by default.",
  },
  {
    title: "One simple shortcut",
    desc: "Default is Fn/Globe. Change it to any key combo you like. Hold to talk, release to get your text. No menus, no buttons.",
  },
  {
    title: "Open source, MIT licensed",
    desc: "Full source on GitHub. Read every line. No third-party tracking, no surprises. Build it yourself if you want.",
  },
];

// Speech models — mirrors the in-app catalog (ASRModelCatalog.swift),
// ordered the way Suniye recommends them.
const models = [
  { name: "Parakeet TDT 0.6B v3", langs: "25 European languages", speed: "Balanced", quality: "Best", size: "~680 MB", tag: "Recommended" },
  { name: "Parakeet TDT 0.6B v2", langs: "English", speed: "Balanced", quality: "Better", size: "~482 MB", tag: null },
  { name: "SenseVoice", langs: "Chinese · English · Japanese · Korean · Cantonese", speed: "Balanced", quality: "Better", size: "~240 MB", tag: "Multilingual" },
  { name: "Moonshine Base", langs: "English", speed: "Fast", quality: "Good", size: "~285 MB", tag: null },
  { name: "Whisper Large v3 Turbo", langs: "Multilingual", speed: "Fast", quality: "Best", size: "~564 MB", tag: null },
  { name: "Whisper Distil Large v3", langs: "Multilingual", speed: "Balanced", quality: "Best", size: "~529 MB", tag: null },
  { name: "Whisper Large v3", langs: "Multilingual", speed: "Slower", quality: "Best", size: "~1.7 GB", tag: null },
  { name: "Whisper Small (English)", langs: "English", speed: "Balanced", quality: "Better", size: "~636 MB", tag: null },
  { name: "Whisper Base (English)", langs: "English", speed: "Fast", quality: "Good", size: "~209 MB", tag: null },
  { name: "Whisper Tiny (English)", langs: "English", speed: "Fast", quality: "Basic", size: "~118 MB", tag: null },
];

// Magic Format providers — mirrors MagicFormatProvider in LLMSettings.swift.
// Automatic mode cascades top-to-bottom, staying on-device whenever it can.
const cleanupTiers = [
  {
    step: "01",
    name: "Apple Intelligence",
    onDevice: true,
    tagline: "On your Mac · no setup",
    desc: "Uses Apple's built-in AI on supported Macs. Nothing leaves your machine, nothing to set up, no cost.",
  },
  {
    step: "02",
    name: "A model on your Mac",
    onDevice: true,
    tagline: "On your Mac · works offline",
    desc: "Runs a small AI model right on your Mac (about 3.4 GB). Download it once, then clean up text even with no internet.",
  },
  {
    step: "03",
    name: "Your own provider",
    onDevice: false,
    tagline: "Optional · uses the internet",
    desc: "Connect your own AI provider — like Gemini or GPT — with your own key. Only text is sent, and only if you pick this option.",
  },
];

const moreFeatures = [
  {
    title: "Floating indicator",
    desc: "A draggable capsule shows live audio levels while you talk. Park it in any corner — or hide it when idle.",
  },
  {
    title: "History & dashboard",
    desc: "Every dictation is saved on your Mac with word counts and timing. Copy or delete from a simple dashboard.",
  },
  {
    title: "Any microphone",
    desc: "Built-in, USB, or Bluetooth — switch freely. Suniye tunes itself to each device automatically.",
  },
  {
    title: "Automatic updates",
    desc: "New versions arrive on their own. Stay on stable releases, or opt in to early builds to try new features first.",
  },
  {
    title: "Launch at login",
    desc: "Start Suniye quietly in the background so it's ready the moment you press your key.",
  },
  {
    title: "Safe insertion",
    desc: "Your text lands at the cursor and your clipboard is kept intact. Optionally press Return to send automatically.",
  },
  {
    title: "Learns from your edits",
    desc: "Correct a misheard name right after dictating and Suniye quietly adds it to your vocabulary — undoable, marked with a ✨, and easy to switch off.",
  },
];

// Capability matrix. Columns are categories, not named products, so every
// claim stays defensible as competitors change.
const compareCols = ["Suniye", "Cloud dictation", "Built-in dictation"];
const compareRows = [
  { label: "Audio stays on your Mac", values: ["yes", "no", "some"] },
  { label: "Choice of speech models", values: ["yes", "no", "no"] },
  { label: "Works in many languages", values: ["yes", "yes", "yes"] },
  { label: "AI cleanup that can run on your Mac", values: ["yes", "cloud", "no"] },
  { label: "Inserts into any app", values: ["yes", "some", "yes"] },
  { label: "Open source", values: ["yes", "no", "no"] },
  { label: "No third-party tracking", values: ["yes", "varies", "varies"] },
  { label: "Price", values: ["Free", "Subscription", "Free"] },
];

const faqs = [
  {
    q: "Is my dictation really private?",
    a: "Yes. Your voice is captured and turned into text entirely on your Mac — it never touches the internet. To improve the app, Suniye does send a small amount of pseudonymous usage data (counts and timings — never your words), which you can turn off in Settings → Privacy; the privacy page lists exactly what's collected. Otherwise it only goes online to check for updates and download a model the first time.",
  },
  {
    q: "Does the optional AI cleanup see my audio?",
    a: "Never. Cleanup only works on the text, never the audio. By default it runs right on your Mac, using Apple's built-in AI or a local model. Only if you turn on the online option does your text get sent to the provider you choose — and it's off by default.",
  },
  {
    q: "What languages can it understand?",
    a: "It depends on the model you pick. Some cover 25 European languages, others handle Chinese, Japanese, Korean, English, and Cantonese, and the largest understand a broad mix. Several English-only models are smaller and faster.",
  },
  {
    q: "Does it work offline?",
    a: "Yes — once you've downloaded a model, dictation itself needs no internet at all. Suniye does phone home for a few non-dictation things: pseudonymous usage stats (opt-out in Settings) and update checks, plus the optional online cleanup provider if you turn it on.",
  },
  {
    q: "Apple Silicon or Intel?",
    a: "Both work for dictation. The on-Mac cleanup model needs an Apple Silicon Mac (M1 or later), and Apple's built-in AI needs a Mac that supports it. The online cleanup option works on any Mac.",
  },
  {
    q: "How much space does it need?",
    a: "A speech model is anywhere from about 118 MB to 1.7 GB, so you can pick one that fits. The optional on-Mac cleanup model adds about 3.4 GB.",
  },
  {
    q: "Can I install with Homebrew?",
    a: "Yes — it's the easiest way. Run brew install --cask kishanhitk/tap/suniye. Homebrew downloads the latest release, moves Suniye into your Applications folder, and clears the macOS quarantine for you, so there's nothing extra to do on first launch. Updates still arrive automatically inside the app.",
  },
  {
    q: "Homebrew asks me to trust the tap — is that expected?",
    a: "Yes. Homebrew 6 asks you to approve any third-party tap before it runs, because a tap can run code on your Mac. Running the full command — brew install --cask kishanhitk/tap/suniye — trusts just this one cask. If you'd like to read it first, run brew cat kishanhitk/tap/suniye.",
  },
  {
    q: "Why does macOS say the app is damaged?",
    a: "This only affects the direct .dmg download. Suniye isn't signed with a paid Apple developer certificate, so macOS quarantines it the first time. Run the command shown above to allow it — or install with Homebrew, which clears the quarantine for you. You can also build it yourself from the source on GitHub.",
  },
  {
    q: "Is it free?",
    a: "Completely. Free and open-source under the MIT license. No subscription, no account, no third-party tracking.",
  },
];
---

<Layout>
  <!-- ── Nav ──────────────────────────────── -->
  <Navbar variant="home" />

  <!-- With JS off, reveal-on-scroll never fires — show everything up front. -->
  <noscript>
    <style>
      .reveal, .hero-word, .fade-in { opacity: 1 !important; transform: none !important; animation: none !important; }
      .waveform-path { stroke-dashoffset: 0 !important; }
    </style>
  </noscript>

  <main>
    <!-- ── Hero ─────────────────────────────── -->
    <section class="relative overflow-hidden pt-36 pb-24 md:pt-44 md:pb-32">
      <div class="hero-glow left-[-6rem] top-[1.5rem] h-[24rem] w-[32rem]" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-6xl px-6">
        <div class="max-w-3xl">
          <!-- Waveform SVG — decorative -->
          <svg
            class="mb-8 h-10 w-auto text-accent md:h-14"
            viewBox="0 0 160 80"
            fill="none"
            aria-hidden="true"
          >
            <path
              class="waveform-path"
              d="M 8 50 Q 14 50 20 42 L 40 10 L 62 70 L 84 10 L 106 70 L 124 36 Q 130 26 140 26"
              stroke="currentColor"
              stroke-width="7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <h1 class="font-display text-4xl leading-tight tracking-tight md:text-6xl md:leading-[1.1]">
            {heroWords.map((word, i) => (
              <span
                class="hero-word"
                style={`animation-delay: ${0.08 + i * 0.06}s`}
              >
                {word}{" "}
              </span>
            ))}
          </h1>

          <p class="fade-in mt-6 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
            Suniye is open-source dictation for macOS. Speech recognition runs
            locally — nothing leaves your machine. Hold one key, speak, release.
          </p>

          <!-- Recommended install: Homebrew -->
          <div class="fade-in mt-10 max-w-lg">
            <div class="mb-2 flex items-center gap-2">
              <span class="font-display text-xs uppercase tracking-widest text-muted">Install with Homebrew</span>
              <span class="pill pill-accent">Recommended</span>
            </div>
            <CopyField value={brewInstall} label="Copy install command" dataTrack="download_click:homebrew" />
          </div>

          <p class="fade-in mt-3 font-display text-sm text-muted">
            or
            <a
              href={downloadUrl}
              data-dmg
              data-track="download_click:dmg"
              class="text-ink underline decoration-border underline-offset-4 transition-colors hover:decoration-ink"
            >
              download the app directly
            </a>
          </p>

        </div>

        <!-- ── Demo video — the hero's signature element ─ -->
        <!-- Framed as the Suniye app window so it reads as the real thing. -->
        <!-- Click-to-play with sound: the narration is the point, and browsers -->
        <!-- block autoplay-with-audio, so we lead with a poster + play affordance. -->
        <figure class="reveal mt-16 md:mt-24">
          <div
            class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-border bg-surface shadow-[var(--shadow-float)]"
          >
            <!-- Titlebar, echoing the macOS app chrome used elsewhere on the page -->
            <div class="flex items-center gap-1.5 border-b border-border/70 bg-surface/70 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="ml-2.5 flex items-center gap-1.5 font-display text-[11px] tracking-tight text-muted/70">
                <img src="/suniye-icon.png" alt="" class="h-3.5 w-3.5 rounded-[3px]" />
                Suniye
              </span>
            </div>

            <div class="relative bg-ink">
              <video
                id="demo-video"
                class="block w-full"
                poster="/demo-poster.jpg"
                preload="metadata"
                playsinline
                data-track-video
              >
                <source src="/demo.mp4" type="video/mp4" />
                Your browser can't play this video.
                <a href="/demo.mp4" class="underline">Download the demo</a> instead.
              </video>

              <!-- Live stopwatch, synced to the real playback time -->
              <div
                id="demo-timer"
                class="pointer-events-none absolute right-3 top-3 z-20 rounded-md bg-ink/70 px-2.5 py-1 font-display text-xs tabular-nums tracking-tight text-white backdrop-blur-sm"
                aria-hidden="true"
              >
                00:00.000
              </div>

              <!-- Play affordance — clicking starts playback with sound + controls -->
              <button
                id="demo-play"
                type="button"
                class="demo-play group absolute inset-0 flex items-center justify-center bg-ink/25 transition-opacity duration-300"
                aria-label="Play the demo with sound"
              >
                <span
                  class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-accent text-white shadow-xl ring-1 ring-white/10 transition-transform duration-150 [transition-timing-function:var(--curve-out)] group-hover:scale-105 group-active:scale-95 md:h-[88px] md:w-[88px]"
                >
                  <svg class="h-7 w-7 translate-x-[2px] md:h-9 md:w-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 4.5l13 7.5-13 7.5z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <figcaption class="mt-4 text-center font-display text-xs tracking-wide text-muted/60">
            A real, unedited take.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ── How it works ─────────────────────── -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="reveal font-display text-sm uppercase tracking-widest text-muted">
          How it works
        </h2>

        <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
          {steps.map((step, i) => (
            <div class="reveal" style={`transition-delay: ${i * 0.06}s`}>
              <span class="font-display text-5xl tracking-tighter text-accent/25">
                {step.num}
              </span>
              <h3 class="mt-3 font-display text-lg tracking-tight">
                {step.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Features ─────────────────────────── -->
    <section class="border-t border-border/60 bg-surface/50 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="reveal font-display text-sm uppercase tracking-widest text-muted">
          Built for real work
        </h2>

        <div class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {features.map((f, i) => (
            <div
              class="reveal border-l-2 border-accent/20 pl-5"
              style={`transition-delay: ${i * 0.06}s`}
            >
              <h3 class="font-display text-base tracking-tight">{f.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">
                {f.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Speech models ────────────────────── -->
    <section id="models" class="scroll-mt-20 border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal max-w-2xl">
          <h2 class="font-display text-sm uppercase tracking-widest text-muted">
            Choose your model
          </h2>
          <p class="mt-5 text-2xl leading-snug tracking-tight md:text-3xl">
            Ten speech models. Pick the trade-off you want —
            <span class="text-accent">speed, accuracy, or languages.</span>
          </p>
          <p class="mt-4 leading-relaxed text-muted">
            Every model runs entirely on your Mac. Download more than one and switch
            instantly from the app — no restart, nothing sent to a server.
          </p>
        </div>

        <!-- Desktop table -->
        <div class="reveal mt-12 hidden md:block" style="transition-delay: 0.1s">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-border font-display text-xs uppercase tracking-wider text-muted">
                <th class="py-3 pr-4 font-normal">Model</th>
                <th class="py-3 pr-4 font-normal">Languages</th>
                <th class="py-3 pr-4 font-normal">Speed</th>
                <th class="py-3 pr-4 font-normal">Quality</th>
                <th class="py-3 pr-4 text-right font-normal">Size</th>
              </tr>
            </thead>
            <tbody>
              {models.map((m) => (
                <tr
                  class:list={[
                    "border-b border-border/50 align-middle transition-colors",
                    m.tag === "Recommended"
                      ? "bg-accent/[0.04] hover:bg-accent/[0.07]"
                      : "hover:bg-surface/60",
                  ]}
                >
                  <td class="py-4 pr-4">
                    <span class="font-display text-[15px] tracking-tight text-ink">{m.name}</span>
                    {m.tag && <span class="pill pill-accent ml-2">{m.tag}</span>}
                  </td>
                  <td class="py-4 pr-4 text-sm text-muted">{m.langs}</td>
                  <td class="py-4 pr-4 text-sm text-muted">{m.speed}</td>
                  <td class="py-4 pr-4 text-sm text-muted">{m.quality}</td>
                  <td class="py-4 pr-4 text-right font-display text-sm tabular-nums text-muted">{m.size}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile cards -->
        <div class="reveal mt-10 grid gap-3 md:hidden">
          {models.map((m) => (
            <div
              class:list={[
                "card card-hover p-4",
                m.tag === "Recommended" ? "card-accent" : "bg-surface/40",
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="font-display text-[15px] tracking-tight text-ink">{m.name}</span>
                {m.tag && <span class="pill pill-accent shrink-0">{m.tag}</span>}
              </div>
              <p class="mt-1.5 text-sm text-muted">{m.langs}</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-display text-xs text-muted/80">
                <span>{m.speed}</span>
                <span>{m.quality}</span>
                <span class="tabular-nums">{m.size}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Magic Format / AI cleanup ────────── -->
    <section id="cleanup" class="scroll-mt-20 border-t border-border/60 bg-surface/50 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal max-w-2xl">
          <h2 class="font-display text-sm uppercase tracking-widest text-muted">
            Magic Format
          </h2>
          <p class="mt-5 text-2xl leading-snug tracking-tight md:text-3xl">
            Cleanup that can stay
            <span class="text-accent">entirely on your Mac.</span>
          </p>
          <p class="mt-4 leading-relaxed text-muted">
            Optionally tidy up punctuation, capitalization, and formatting after each
            dictation. It stays off until you turn it on.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {cleanupTiers.map((t, i) => (
            <div
              class:list={[
                "reveal card card-hover flex flex-col p-6",
                t.onDevice ? "card-accent" : "bg-bg",
              ]}
              style={`transition-delay: ${i * 0.06}s`}
            >
              <div class="flex items-center justify-between">
                <span class="font-display text-3xl tracking-tighter text-accent/25">{t.step}</span>
                <span class:list={["pill", t.onDevice ? "pill-accent" : "pill-muted"]}>
                  {t.onDevice ? "On your Mac" : "Optional"}
                </span>
              </div>
              <h3 class="mt-4 font-display text-lg tracking-tight">{t.name}</h3>
              <p class="mt-1 font-display text-xs text-muted/70">{t.tagline}</p>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{t.desc}</p>
            </div>
          ))}
        </div>

        <p class="reveal mt-6 font-display text-xs leading-relaxed text-muted/70">
          Your audio is never sent anywhere. Magic Format only ever works on the
          text you dictated, and only the last option uses the internet.
        </p>
      </div>
    </section>

    <!-- ── Privacy ──────────────────────────── -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal max-w-3xl">
          <h2 class="font-display text-3xl leading-snug tracking-tight md:text-5xl md:leading-tight">
            Every word you dictate could be
            <span class="text-accent">training data.</span>
          </h2>
          <p class="mt-2 font-display text-3xl leading-snug tracking-tight text-muted md:text-5xl md:leading-tight">
            Unless it never leaves your machine.
          </p>
        </div>

        <div class="reveal mt-12 grid max-w-4xl gap-8 md:grid-cols-2" style="transition-delay: 0.15s">
          <div>
            <h3 class="font-display text-sm uppercase tracking-widest text-muted">
              The problem
            </h3>
            <p class="mt-4 leading-relaxed text-muted">
              Cloud dictation services process your voice on remote servers.
              Your private notes, medical records, business plans — all passing
              through infrastructure you don't control. That audio can be stored,
              analyzed, and used to train models without your explicit consent.
            </p>
          </div>
          <div>
            <h3 class="font-display text-sm uppercase tracking-widest text-muted">
              Suniye's approach
            </h3>
            <p class="mt-4 leading-relaxed text-muted">
              Speech models run directly on your Mac — pick one from the built-in
              library. Voice is processed in memory, transcribed locally, and never
              touches a network.
            </p>
            <p class="mt-4 text-sm leading-relaxed text-muted/70">
              Even the optional cleanup can stay on your Mac, using Apple's built-in AI
              or a local model. Only if you pick the online option does your text
              (never your audio) leave the Mac — and it's off by default.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── More features ────────────────────── -->
    <section class="border-t border-border/60 bg-surface/50 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="reveal font-display text-sm uppercase tracking-widest text-muted">
          More in the box
        </h2>

        <div class="mt-14 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {moreFeatures.map((f, i) => (
            <div class="reveal" style={`transition-delay: ${i * 0.06}s`}>
              <h3 class="font-display text-base tracking-tight">{f.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Comparison ───────────────────────── -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="reveal max-w-2xl">
          <h2 class="font-display text-sm uppercase tracking-widest text-muted">
            How it compares
          </h2>
          <p class="mt-5 text-2xl leading-snug tracking-tight md:text-3xl">
            Local-first, by design.
          </p>
        </div>

        <div class="reveal mt-12 overflow-x-auto" style="transition-delay: 0.1s">
          <table class="w-full min-w-[560px] border-collapse text-left">
            <thead>
              <tr class="border-b border-border">
                <th class="py-4 pr-4"></th>
                {compareCols.map((col, i) => (
                  <th
                    class:list={[
                      "py-4 px-4 text-center font-display text-sm tracking-tight",
                      i === 0 ? "bg-accent/[0.06] text-accent" : "text-muted",
                    ]}
                  >
                    {col}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {compareRows.map((row) => (
                <tr class="border-b border-border/50">
                  <td class="py-4 pr-4 text-sm text-muted">{row.label}</td>
                  {row.values.map((v, i) => (
                    <td
                      class:list={[
                        "py-4 px-4 text-center",
                        i === 0 ? "bg-accent/[0.05]" : "",
                      ]}
                    >
                      {v === "yes" ? (
                        <svg class="mx-auto h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-label="Yes">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      ) : v === "no" ? (
                        <span class="text-muted/30" aria-label="No">—</span>
                      ) : (
                        <span class="font-display text-xs capitalize text-muted/80">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="reveal mt-4 font-display text-xs text-muted/60">
          "Cloud dictation" and "built-in dictation" describe common categories — capabilities vary by product.
        </p>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────── -->
    <section id="faq" class="scroll-mt-20 border-t border-border/60 bg-surface/50 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.6fr] lg:gap-16">
          <h2 class="reveal font-display text-sm uppercase tracking-widest text-muted lg:sticky lg:top-28 lg:self-start">
            Questions
          </h2>

          <div class="reveal divide-y divide-border/70 border-y border-border/70" style="transition-delay: 0.1s">
            {faqs.map((item) => (
              <details class="faq-item group">
                <summary class="flex items-center justify-between gap-4 py-5">
                  <span class="font-display text-base tracking-tight text-ink">{item.q}</span>
                  <span class="faq-sign shrink-0 text-xl leading-none text-accent">+</span>
                </summary>
                <p class="pb-5 text-[15px] leading-relaxed text-muted">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Download CTA ─────────────────────── -->
    <section class="border-t border-border/60 py-24 md:py-32">
      <div class="mx-auto max-w-6xl px-6 text-center">
        <div class="reveal mx-auto max-w-xl">
          <h2 class="font-display text-3xl tracking-tight md:text-4xl">
            Try Suniye
          </h2>
          <p class="mt-4 leading-relaxed text-muted">
            Install with Homebrew, download the latest release, or build from
            source. Requires macOS 14 (Sonoma) or later. Pick a speech model from
            the built-in library on first launch.
          </p>

          <!-- Recommended install: Homebrew -->
          <div class="mt-8 mx-auto max-w-md">
            <div class="mb-2 flex items-center justify-center gap-2">
              <span class="font-display text-xs uppercase tracking-widest text-muted">Install with Homebrew</span>
              <span class="pill pill-accent">Recommended</span>
            </div>
            <CopyField value={brewInstall} label="Copy install command" class="text-left" dataTrack="download_click:homebrew" />
          </div>

          <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
            <a
              href={downloadUrl}
              data-dmg
              data-track="download_click:dmg"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 font-display text-sm text-ink hover:bg-surface"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3" />
              </svg>
              Download .dmg
            </a>
            <a
              href={`${githubUrl}#build-from-source`}
              target="_blank"
              rel="noopener"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 font-display text-sm text-ink hover:bg-surface"
            >
              Build from Source
            </a>
          </div>

          <p class="mt-8 inline-block rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 font-display text-xs tracking-wide text-accent">
            Alpha — expect rough edges
          </p>
        </div>
      </div>
    </section>

    <!-- ── Quarantine notice — surfaced after a .dmg download ─ -->
    <!-- A centered dialog so it lands front-and-centre the moment you download. -->
    <div
      id="dmg-banner"
      class="dmg-modal fixed inset-0 z-[70] flex items-center justify-center px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dmg-title"
    >
      <div class="dmg-scrim absolute inset-0 bg-ink/45 backdrop-blur-sm" data-dmg-close></div>

      <div class="dmg-card relative w-full max-w-md overflow-hidden rounded-2xl border border-border bg-bg p-6 shadow-[0_50px_120px_-24px_rgba(26,26,26,0.55)]">
        <div class="flex items-start gap-3">
          <p id="dmg-title" class="flex-1 font-display text-base leading-snug tracking-tight text-ink">
            Clear quarantine if macOS blocks it
          </p>
          <button
            id="dmg-banner-close"
            type="button"
            class="btn-press -mt-0.5 flex-none rounded-md p-1 text-muted/50 hover:bg-surface hover:text-ink"
            aria-label="Dismiss"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>

        <p class="mt-2 text-sm leading-relaxed text-muted">
          Suniye isn't signed with a paid Apple Developer Certificate, so macOS
          quarantines the .dmg. Run this once to remove it.
        </p>

        <CopyField value={quarantineCmd} label="Copy command" class="mt-4" />

        <div class="mt-5 flex justify-end">
          <button
            type="button"
            data-dmg-close
            class="btn-press rounded-lg bg-ink px-5 py-2.5 font-display text-sm text-bg hover:bg-ink/85"
          >
            Got it
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- ── Footer ─────────────────────────────── -->
  <footer class="border-t border-border/60 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 md:flex-row">
      <div class="flex items-center gap-2.5">
        <img src="/suniye-icon.png" alt="" class="h-5 w-5 rounded-[3px]" />
        <span class="font-display text-sm text-muted">
          Suniye &middot; MIT License
        </span>
      </div>
      <div class="flex items-center gap-6 font-display text-sm text-muted">
        <a href={githubUrl} target="_blank" rel="noopener" data-track="outbound_click:github" class="transition-colors hover:text-ink">
          GitHub
        </a>
        <a href={`${githubUrl}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener" class="transition-colors hover:text-ink">
          Contributing
        </a>
        <a href={`${githubUrl}/issues`} target="_blank" rel="noopener" class="transition-colors hover:text-ink">
          Issues
        </a>
        <a href="/changelog" class="transition-colors hover:text-ink">
          Changelog
        </a>
      </div>
    </div>
  </footer>

  <!-- ── Scroll reveal observer ─────────────── -->
  <script>
    const revealEls = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      // No observer support — reveal everything rather than leave it hidden.
      revealEls.forEach((el) => el.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      revealEls.forEach((el) => observer.observe(el));
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Demo video: click the poster overlay to play with sound + native controls,
    // and run a stopwatch read from the real playback clock. Under reduced motion
    // we drop the 60fps millisecond repaint and tick on the video's own updates.
    const demoVideo = document.getElementById("demo-video");
    const demoPlay = document.getElementById("demo-play");
    const demoTimer = document.getElementById("demo-timer");
    if (demoVideo && demoPlay) {
      const fmt = (t) => {
        const base =
          String(Math.floor(t / 60)).padStart(2, "0") + ":" +
          String(Math.floor(t % 60)).padStart(2, "0");
        if (reduceMotion) return base;
        return base + "." + String(Math.floor((t % 1) * 1000)).padStart(3, "0");
      };
      const render = () => {
        if (demoTimer) demoTimer.textContent = fmt(demoVideo.currentTime);
      };
      let raf = 0;
      const tick = () => {
        render();
        raf = requestAnimationFrame(tick);
      };
      render();
      demoVideo.addEventListener("play", () => {
        if (reduceMotion) return;
        cancelAnimationFrame(raf);
        tick();
      });
      demoVideo.addEventListener("pause", () => {
        cancelAnimationFrame(raf);
        render();
      });
      demoVideo.addEventListener("seeked", render);
      if (reduceMotion) demoVideo.addEventListener("timeupdate", render);
      demoPlay.addEventListener("click", () => {
        demoVideo.controls = true;
        demoPlay.classList.add("is-playing");
        demoVideo.play().catch(() => {
          demoPlay.classList.remove("is-playing");
          demoVideo.controls = false;
        });
      });
      demoVideo.addEventListener("ended", () => {
        cancelAnimationFrame(raf);
        render();
        demoVideo.controls = false;
        demoPlay.classList.remove("is-playing");
      });
    }

    // Surface the quarantine notice once the user grabs the app directly.
    // As an aria-modal dialog it owns focus while open: move focus in, trap Tab,
    // lock body scroll, and restore focus to the trigger on close.
    const dmgBanner = document.getElementById("dmg-banner");
    if (dmgBanner) {
      const card = dmgBanner.querySelector(".dmg-card");
      const closeEl = document.getElementById("dmg-banner-close");
      let lastFocused = null;
      const openDmg = () => {
        lastFocused = document.activeElement;
        dmgBanner.classList.add("is-open");
        document.body.style.overflow = "hidden";
        closeEl?.focus();
      };
      const closeDmg = () => {
        dmgBanner.classList.remove("is-open");
        document.body.style.overflow = "";
        lastFocused?.focus?.();
      };
      document.querySelectorAll("[data-dmg]").forEach((el) => {
        el.addEventListener("click", openDmg);
      });
      // Close via the ×, the "Got it" button, or the backdrop.
      dmgBanner
        .querySelectorAll("[data-dmg-close], #dmg-banner-close")
        .forEach((el) => el.addEventListener("click", closeDmg));
      document.addEventListener("keydown", (e) => {
        if (!dmgBanner.classList.contains("is-open")) return;
        if (e.key === "Escape") {
          closeDmg();
        } else if (e.key === "Tab" && card) {
          const items = card.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Copy the command associated with each copy button to the clipboard.
    // Prefer the button's data-copy; fall back to the adjacent <code> text.
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text =
          btn.getAttribute("data-copy") ||
          btn.parentElement?.querySelector("code")?.textContent?.trim() ||
          "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 2000);
        } catch {
          // Clipboard API unavailable (e.g. insecure context) — fail silently.
        }
      });
    });
  </script>
</Layout>

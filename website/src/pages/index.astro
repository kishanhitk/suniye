---
import Layout from "../layouts/Layout.astro";
import CopyField from "../components/CopyField.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { softwareApplicationSchema, faqPageSchema, jsonLdString } from "../lib/seo";

const githubUrl = "https://github.com/kishanhitk/suniye";
const downloadUrl = "https://github.com/kishanhitk/suniye/releases/latest/download/Suniye.dmg";
const brewInstall = "brew install --cask kishanhitk/tap/suniye";
const quarantineCmd = "xattr -rd com.apple.quarantine /Applications/Suniye.app";

// The whole argument in two paths. Deliberately structural rather than
// benchmarked: "no round trip" is true by construction, a millisecond figure
// would need a measurement this page can't show.
const cloudPath = [
  "You speak",
  "Your audio is uploaded",
  "A server transcribes it",
  "The text travels back",
];
const localPath = ["You speak", "Your Mac transcribes it", "The text is at your cursor"];

const pillars = [
  {
    title: "Works where you type",
    desc: "Mail, Slack, Notes, your editor, your browser. The text lands at the cursor and your clipboard is left exactly as you had it.",
  },
  {
    title: "Choose how it listens",
    desc: "Swap the speech model to suit your Mac — small and quick, or large and exacting. Apple's built-in engine needs no download at all.",
  },
  {
    title: "Cleanup that stays home",
    desc: "Optional Magic Format tidies grammar and punctuation using Apple Intelligence or a model on your Mac. Off until you turn it on.",
  },
  {
    title: "Free, and readable",
    desc: "MIT licensed, no account, no subscription, no third-party tracking. Every line is on GitHub if you want to check the claims yourself.",
  },
];

// Mirrors the in-app catalog (ASRModelCatalog.swift). Kept behind a disclosure:
// the fact that you get a choice is the point, the eleven rows are reference.
const models = [
  { name: "Apple Speech", langs: "Follows your system language", size: "Built in", tag: "macOS 26+" },
  { name: "Parakeet TDT 0.6B v3", langs: "25 European languages", size: "~680 MB", tag: "Recommended" },
  { name: "Parakeet TDT 0.6B v2", langs: "English", size: "~482 MB", tag: null },
  { name: "SenseVoice", langs: "Chinese · English · Japanese · Korean · Cantonese", size: "~240 MB", tag: null },
  { name: "Moonshine Base", langs: "English", size: "~285 MB", tag: null },
  { name: "Whisper Large v3 Turbo", langs: "Multilingual", size: "~564 MB", tag: null },
  { name: "Whisper Distil Large v3", langs: "Multilingual", size: "~529 MB", tag: null },
  { name: "Whisper Large v3", langs: "Multilingual", size: "~1.7 GB", tag: null },
  { name: "Whisper Small (English)", langs: "English", size: "~636 MB", tag: null },
  { name: "Whisper Base (English)", langs: "English", size: "~209 MB", tag: null },
  { name: "Whisper Tiny (English)", langs: "English", size: "~118 MB", tag: null },
];

// Straight from the Magic Format eval suite (evals/magic_format_cases.json and
// magic_format_advanced_cases.json) — the cases the shipped prompt is scored
// against, so the page can't claim behaviour the model doesn't have.
const cleanups = [
  {
    label: "It follows the correction, not the words",
    said: "get flowers on monday buy roses no no wait actually get lilies",
    wrote: "Get lilies on Monday.",
  },
  {
    label: "Spoken numbers become written ones",
    said: "the workshop is from eight forty five to eleven thirty and the budget is fifteen thousand dollars",
    wrote: "The workshop is from 8:45 to 11:30 and the budget is $15,000.",
  },
  {
    label: "Say it as a list and it arrives as one",
    said: "do these in order first check the logs second restart the app third send me the result",
    wrote: "Do these in order:\n1. Check the logs\n2. Restart the app\n3. Send me the result",
  },
];

// The point of per-app prompts: one sentence, three destinations, three registers.
// These are illustrative of a prompt you would write, not measured output.
const tones = [
  { app: "Slack", prompt: "Terse. No greeting, no sign-off.", out: "Deploy is blocked on the cert renewal — ETA tomorrow." },
  { app: "Mail", prompt: "Full sentences, polite, sign off.", out: "Hi,\n\nThe deploy is blocked on the certificate renewal. I expect it to clear tomorrow.\n\nThanks!" },
  { app: "Notes", prompt: "Keep it raw. Just fix punctuation.", out: "deploy blocked — cert renewal, should clear tomorrow" },
];

const surfaces = ["Mail", "Slack", "Notes", "Messages", "Xcode", "VS Code", "Safari", "Chrome", "Notion", "Obsidian", "Terminal", "Figma"];

const faqs = [
  {
    q: "Is my dictation really private?",
    a: "Your voice is captured and turned into text entirely on your Mac — the audio never touches the internet. Suniye does send a small amount of pseudonymous usage data (counts and timings, never your words), which you can switch off in Settings → Privacy; the privacy page lists exactly what is collected. Otherwise it goes online only to check for updates and to download a model the first time.",
  },
  {
    q: "Does the optional AI cleanup see my audio?",
    a: "Never. Cleanup only ever works on the text. By default it runs on your Mac, using Apple Intelligence or a local model. Only if you deliberately turn on the online option does your text reach a provider you chose — and it is off by default.",
  },
  {
    q: "Does it work offline?",
    a: "Yes. Once a model is downloaded, dictation needs no connection at all — including on a plane. The only things that use the network are update checks, the opt-out usage stats, and the online cleanup provider if you enable it.",
  },
  {
    q: "What languages can it understand?",
    a: "It depends on the model you pick. Some cover 25 European languages, others handle Chinese, Japanese, Korean, English and Cantonese, and the largest understand a broad mix. Several English-only models are smaller and faster.",
  },
  {
    q: "Why does macOS say the app is damaged?",
    a: "Only the direct .dmg download is affected. Suniye is not signed with a paid Apple Developer certificate, so macOS quarantines it on first launch. Run xattr -rd com.apple.quarantine /Applications/Suniye.app once to clear it — Suniye also offers the command right after you download the .dmg. Installing with Homebrew avoids it entirely, since brew clears the quarantine for you.",
  },
  {
    q: "How fast is it, really?",
    a: "Median speech to text is 177 ms with Apple's built-in engine — fast enough that the text is usually there before you have finished letting go of the key. Downloaded models trade a little speed for accuracy, and the first dictation after launch waits for the model to load. Turning on Magic Format adds about a second, since a second model then rewrites the transcript.",
  },
  {
    q: "Is it free?",
    a: "Completely. Free and open source under the MIT license. No subscription, no account, no third-party tracking.",
  },
];
---

<Layout>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(softwareApplicationSchema())}
  />
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(faqPageSchema(faqs))}
  />
  <!-- Preload the same candidate set the <picture> will resolve, so the
       preloader fetches the tier this viewport actually needs rather than a
       fixed file it may then discard. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset="/hero-700.webp 700w, /hero-1100.webp 1100w, /hero-1672.webp 1672w"
    imagesizes="100vw"
    type="image/webp"
  />

  <Navbar variant="over-art" />

  <!-- With JS off, reveal-on-scroll never fires — show everything up front. -->
  <noscript>
    <style>
      .reveal, .js-reveal .reveal, .fade-in { opacity: 1 !important; transform: none !important; animation: none !important; }
    </style>
  </noscript>

  <main>
    <!-- ── Hero ─────────────────────────────── -->
    <!-- The painting is the page's whole first impression, so it is a real <img>
         (decoding early, preloaded) rather than a CSS background: the browser
         can then prioritise it as the LCP element. -->
    <section id="hero" class="hero-ground relative flex min-h-[100svh] flex-col overflow-hidden bg-[#2b6cc4]">
      <!-- An 853-byte blurred copy of the painting is inlined as the section's own
           background, so the first paint already has the right colour and shape
           under the headline. The real image fades over it once decoded — the
           browser picks the width. The ladder stops at 1672 because that is the
           painting's native size — anything wider is resampled, not sharper. -->
      <picture>
        <source
          srcset="
            /hero-700.webp   700w,
            /hero-1100.webp 1100w,
            /hero-1672.webp 1672w
          "
          sizes="100vw"
          type="image/webp"
        />
        <img
          src="/hero.jpg"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="hero-art is-loading"
          data-hero-art
        />
      </picture>

      <div class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-6 pt-24 pb-[48vh] text-center sm:pt-28 sm:pb-[38vh]">
        <h1 class="on-art font-display text-[clamp(2.75rem,6.6vw,5rem)] font-medium leading-[1.02] tracking-[-0.02em]">
          Speak freely.
        </h1>

        <p class="on-art-muted fade-in mx-auto mt-5 max-w-[34em] text-[17px] leading-relaxed">
          Suniye is dictation built for privacy and speed: the models run on your
          Mac, so nothing is uploaded and the words land as fast as you say them.
        </p>

        <div class="fade-in mt-7 flex justify-center">
          <a
            href={downloadUrl}
            data-dmg
            data-track="download_click:dmg_hero"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>

        <button
          type="button"
          class="brew-line copy-btn fade-in mx-auto mt-5 flex max-w-full items-center gap-2 rounded-md px-2 py-1 font-mono text-[10.5px] text-white/85 transition-colors hover:text-white/95 sm:text-[12px]"
          data-copy={brewInstall}
          data-track="download_click:homebrew_hero"
          aria-label="Copy the Homebrew install command"
        >
          <span aria-hidden="true">$</span>
          {brewInstall}
          <span class="brew-state" aria-hidden="true"></span>
        </button>

        <p class="on-art-muted fade-in mt-4 text-[11px]">
          Apple Silicon &middot; macOS 14+ &middot; Open source
        </p>
      </div>
    </section>

    <!-- ── The argument ─────────────────────── -->
    <!-- The page's thesis, and the only place set at lead size. The two paths are
         a real sequence, so they are numbered; the cloud column is deliberately
         the longer one, and the layout lets it read longer rather than squaring
         both columns into a symmetric pair. -->
    <section class="band relative overflow-hidden">
      <div class="bloom left-[6rem] top-[-8rem] h-[26rem] w-[42rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">The argument</p>
        <div>
          <h2 class="t-lead reveal">Every other dictation app sends your voice away.</h2>
          <p class="t-sub reveal">
            They are built on someone else's API, so your audio has to travel there
            and back before a single word appears. That round trip is the wait &mdash;
            and the privacy question.
          </p>

          <div class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-[0.85fr_1fr]">
            <div class="reveal">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted/60">
                Cloud dictation
              </p>
              <ol class="mt-5 space-y-3.5">
                {cloudPath.map((step, i) => (
                  <li class="flex items-baseline gap-3 text-[15px] text-muted">
                    <span class="font-mono text-[10px] tabular-nums text-muted/40">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    {step}
                  </li>
                ))}
              </ol>
              <p class="mt-6 max-w-[34ch] text-sm leading-relaxed text-muted/75">
                Needs a connection. Your voice sits, however briefly, on a disk you
                don't own.
              </p>
            </div>

            <div class="reveal" style="transition-delay: 0.08s">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">
                Suniye
              </p>
              <ol class="mt-5 space-y-3.5">
                {localPath.map((step, i) => (
                  <li class="flex items-baseline gap-3 text-[15px] text-ink">
                    <span class="font-mono text-[10px] tabular-nums text-accent/50">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    {step}
                  </li>
                ))}
              </ol>
              <p class="mt-3 max-w-[34ch] text-sm leading-relaxed text-muted">
                Works on a plane. Nothing to upload, so there is nothing to keep.
              </p>

              <!-- The page's one warm mark: the measured number, lit like the dawn
                   edge of the painting above it. -->
              <div class="mt-8 border-t border-border pt-6">
                <p class="mark font-display text-[3.25rem] leading-none tracking-tight">
                  177<span class="ml-1 text-2xl text-muted">ms</span>
                </p>
                <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-muted">
                  Median speech&ndash;to&ndash;text with Apple's built-in engine. A
                  network round trip alone often costs more than that.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Demo ─────────────────────────────── -->
    <!-- Click-to-play with sound: the narration is the point, and browsers block
         autoplay-with-audio, so we lead with a poster and a play affordance. -->
    <section class="band">
      <div class="band-inner">
        <p class="rail reveal">The whole interface</p>
        <div>
          <h2 class="t-head reveal">Hold a key. Talk. Let go.</h2>
          <p class="t-sub reveal">
            Default is Fn/Globe; make it any shortcut you like. There is nothing
            else to learn.
          </p>

        <figure class="reveal mt-10" style="transition-delay: 0.1s">
          <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-[var(--shadow-float)]">
            <div class="flex items-center gap-1.5 border-b border-border/70 bg-surface/70 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="ml-2.5 flex items-center gap-1.5 font-mono text-[11px] tracking-tight text-muted/70">
                <img src="/suniye-icon.png" alt="" class="h-3.5 w-3.5 rounded-[3px]" />
                Suniye
              </span>
            </div>

            <div class="relative bg-ink">
              <video
                id="demo-video"
                class="block w-full"
                poster="/demo-poster.jpg"
                preload="metadata"
                playsinline
                data-track-video
              >
                <source src="/demo.mp4" type="video/mp4" />
                Your browser can't play this video.
                <a href="/demo.mp4" class="underline">Download the demo</a> instead.
              </video>

              <!-- Live stopwatch, synced to the real playback clock -->
              <div
                id="demo-timer"
                class="pointer-events-none absolute right-3 top-3 z-20 rounded-md bg-ink/70 px-2.5 py-1 font-mono text-xs tabular-nums tracking-tight text-white backdrop-blur-sm"
                aria-hidden="true"
              >
                00:00.000
              </div>

              <button
                id="demo-play"
                type="button"
                class="demo-play group absolute inset-0 flex items-center justify-center bg-ink/25 transition-opacity duration-300"
                aria-label="Play the demo with sound"
              >
                <span
                  class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-accent text-white shadow-xl ring-1 ring-white/10 transition-transform duration-150 [transition-timing-function:var(--curve-out)] group-hover:scale-105 group-active:scale-95 md:h-[88px] md:w-[88px]"
                >
                  <svg class="h-7 w-7 translate-x-[2px] md:h-9 md:w-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 4.5l13 7.5-13 7.5z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

        </figure>
        </div>
      </div>
    </section>

    <!-- ── Cleanup, shown ───────────────────── -->
    <!-- Every competitor leads with a before/after because it is the only way to
         make "polished text" mean anything. Ours uses the eval suite so the
         right-hand column is behaviour we actually test for. -->
    <!-- Set as an actual transcript: the spoken line in mono at transcript grey,
         the written line directly beneath it in reading type. Stacking them
         vertically shows the transformation as one motion down the page; two
         side-by-side boxes made it a comparison of two separate things. -->
    <section class="band relative overflow-hidden">
      <div class="bloom left-[-10rem] top-[4rem] h-[24rem] w-[34rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">Magic Format</p>
        <div>
          <h2 class="t-head reveal">Speak like a person. Paste like an editor.</h2>
          <p class="t-sub reveal">
            Magic Format cleans the transcript before it lands &mdash; on your Mac,
            using Apple Intelligence or a local model. Optional, and off until you
            turn it on.
          </p>

          <div class="mt-12 divide-y divide-border">
            {cleanups.map((c, i) => (
              <div class="reveal py-8 first:pt-0">
                <p class="font-mono text-[13px] leading-relaxed text-muted/70">
                  {c.said}
                </p>
                <div class="mt-4 flex gap-4">
                  <span class="mt-2 h-px w-8 shrink-0 bg-accent/40" aria-hidden="true"></span>
                  <div>
                    <p class="whitespace-pre-line text-[17px] leading-relaxed text-ink">
                      {c.wrote}
                    </p>
                    <p class="mt-2.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted/50">
                      {c.label}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Anywhere, in the right register ──── -->
    <section class="band relative overflow-hidden">
      <div class="bloom right-[-10rem] top-[6rem] h-[22rem] w-[32rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">Where it works</p>
        <div>
          <h2 class="t-head reveal">One key, every text field.</h2>
          <p class="t-sub reveal">
            No plugin, no per-app setup. The text lands at your cursor and your
            clipboard is left exactly as you had it.
          </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-2.5" style="transition-delay: 0.08s">
          <kbd class="rounded-lg border border-white/70 bg-white/70 px-3 py-1.5 font-mono text-xs text-ink shadow-[0_1px_2px_rgba(18,35,61,0.06)] backdrop-blur-sm">
            fn
          </kbd>
          <span class="font-mono text-xs text-muted/60">hold &rarr;</span>
          {surfaces.map((app) => (
            <span class="rounded-full border border-white/60 bg-white/50 px-3.5 py-1.5 text-[13px] text-muted backdrop-blur-sm">
              {app}
            </span>
          ))}
          <span class="text-[13px] text-muted/60">&hellip; and anywhere else you type</span>
        </div>

        <div class="reveal mt-20" style="transition-delay: 0.12s">
          <h3 class="t-head">The same thought, in the right register.</h3>
          <p class="t-sub">
            Give an app its own Magic Format prompt and Suniye uses it whenever you
            dictate there. Terse in chat, composed in mail, untouched in notes.
          </p>
        </div>

        <div class="mt-10 divide-y divide-border border-t border-border">
          {tones.map((t, i) => (
            <div
              class="reveal grid gap-x-8 gap-y-3 py-7 md:grid-cols-[7rem_1fr]"
             
            >
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">{t.app}</p>
                <p class="mt-2 text-[13px] leading-relaxed text-muted/75">{t.prompt}</p>
              </div>
              <p class="whitespace-pre-line text-[15px] leading-relaxed text-ink">{t.out}</p>
            </div>
          ))}
        </div>

        </div>
      </div>
    </section>

    <!-- ── Models ───────────────────────────── -->
    <!-- The choice is the selling point; the catalogue is reference, so it stays
         folded until someone actually wants to compare sizes. -->
    <section id="models" class="band scroll-mt-20 bg-[linear-gradient(180deg,rgba(43,108,196,0.05),transparent)]">
      <div class="band-inner">
        <p class="rail reveal">Speech models</p>
        <div>
          <h2 class="t-head reveal">Eleven ways to listen.</h2>
          <p class="t-sub reveal">
            From a 118 MB model that keeps up on any Mac to a 1.7 GB one that
            catches everything &mdash; plus Apple's built-in engine, which downloads
            nothing at all. Switch whenever you like; they all run locally.
          </p>

          <ul class="reveal mt-10 divide-y divide-border border-t border-border" style="transition-delay: 0.08s">
            {[models[0], models[1], models[7]].map((m) => (
              <li class="grid gap-x-6 gap-y-1 py-4 md:grid-cols-[13rem_1fr_5rem]">
                <span class="flex items-center gap-2 text-[15px] tracking-tight text-ink">
                  {m.name}
                  {m.tag && <span class="pill pill-accent">{m.tag}</span>}
                </span>
                <span class="text-sm text-muted/80">{m.langs}</span>
                <span class="font-mono text-xs text-muted/60 md:text-right">{m.size}</span>
              </li>
            ))}
          </ul>

        <details class="reveal group mt-8" style="transition-delay: 0.1s" data-track-open="models_list">
          <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-white px-5 py-2.5 font-mono text-[11px] tracking-wide text-muted transition-colors [&::-webkit-details-marker]:hidden hover:text-ink">
            <span class="group-open:hidden">And eight more</span>
            <span class="hidden group-open:inline">Hide the list</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-200 [transition-timing-function:var(--curve-out)] group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <ul class="mt-8 divide-y divide-border border-t border-border">
            {models.filter((_, i) => ![0, 1, 7].includes(i)).map((m) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3.5">
                <span class="text-[15px] tracking-tight text-ink">{m.name}</span>
                {m.tag && <span class="pill pill-accent">{m.tag}</span>}
                <span class="ml-auto font-mono text-xs text-muted/70">{m.size}</span>
                <span class="w-full text-sm text-muted/80">{m.langs}</span>
              </li>
            ))}
          </ul>
        </details>
        </div>
      </div>
    </section>

    <!-- ── Proof ────────────────────────────── -->
    <!-- Deliberately not stars or download counts: at this stage those numbers
         argue against the app. Shipping cadence is the honest signal that an
         alpha is alive, and it is checkable on the releases page. -->
    <section class="border-y border-border bg-white/50 py-7">
      <div class="mx-auto max-w-6xl px-6">
        <!-- One column on phones: the dot separators only make sense while the
             items share a line, and wrapping strands them at the ends of rows. -->
        <ul class="reveal flex flex-col items-center gap-y-2.5 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-muted/70 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-8 sm:gap-y-3">
          <li>MIT licensed</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>
            <a
              href={`${githubUrl}/releases`}
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-ink"
            >
              62 releases since February
            </a>
          </li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>No account</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>Apple Silicon &amp; Intel</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>Free, forever</li>

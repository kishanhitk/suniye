          <div class="reveal divide-y divide-border border-y border-border" style="transition-delay: 0.1s">
            {faqs.map((item) => (
              <details class="faq-item group" data-track-open={`faq_${item.q.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "").slice(0, 40)}`}>
                <summary class="flex items-center justify-between gap-4 py-5">
                  <span class="text-base tracking-tight text-ink">{item.q}</span>
                  <span class="faq-sign shrink-0 text-xl leading-none text-accent">+</span>
                </summary>
                <p class="max-w-[62ch] pb-5 text-[15px] leading-relaxed text-muted">{item.a}</p>
              </details>

---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { softwareApplicationSchema, jsonLdString } from "../lib/seo";
import { BREW_INSTALL, DOWNLOAD_URL } from "../lib/site";
import {
  HERO,
  PRICES,
  PLAN_PRICES,
  PRICE_YEARS,
  planCost,
  formatDollars,
  costPeriod,
  yearsLabel,
  CLAIMS,
  SWITCHING,
  HABITS,
  CLOSING,
} from "../lib/content/home";

// The bars share one scale: the most expensive plan fills the track.
const priciest = Math.max(...PLAN_PRICES.map((plan) => plan.monthly));

// Rendered on demand so the middleware can answer `Accept: text/markdown`
// with the page's Markdown variant; a prerendered page never reaches it.
export const prerender = false;
---

{/* iOS Safari paints the status-bar band above the page with the document's
    background colour, so over the painting it has to be the painting's own sky —
    sampled from the artwork at build time (astro.config.mjs), never pinned. */}
<Layout canvasColor={__HERO_SKY__}>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(softwareApplicationSchema())}
  />
  <!-- Preload the same candidate set the <picture> will resolve, so the
       preloader fetches the tier this viewport actually needs rather than a
       fixed file it may then discard. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset="/hero-700.webp 700w, /hero-1100.webp 1100w, /hero-1672.webp 1672w"
    imagesizes="100vw"
    type="image/webp"
  />

  <Navbar variant="over-art" />

  <!-- With JS off, reveal-on-scroll never fires — show everything up front. -->
  <noscript>
    <style>
      .reveal, .js-reveal .reveal, .fade-in { opacity: 1 !important; transform: none !important; animation: none !important; }
    </style>
  </noscript>

  <main>
    <!-- ── Hero ─────────────────────────────── -->
    <!-- The painting is the page's whole first impression, so it is a real <img>
         (decoding early, preloaded) rather than a CSS background: the browser
         can then prioritise it as the LCP element. -->
    <section id="hero" class="hero-ground relative flex min-h-[100svh] flex-col overflow-hidden bg-[#2b6cc4]">
      <!-- An 853-byte blurred copy of the painting is inlined as the section's own
           background, so the first paint already has the right colour and shape
           under the headline. The real image fades over it once decoded — the
           browser picks the width. The ladder stops at 1672 because that is the
           painting's native size — anything wider is resampled, not sharper. -->
      <picture>
        <source
          srcset="
            /hero-700.webp   700w,
            /hero-1100.webp 1100w,
            /hero-1672.webp 1672w
          "
          sizes="100vw"
          type="image/webp"
        />
        <img
          src="/hero.jpg"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="hero-art is-loading"
          data-hero-art
        />
      </picture>

      <div class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-6 pt-24 pb-[48vh] text-center sm:pt-28 sm:pb-[38vh]">
        <h1 class="on-art font-display text-[clamp(2.75rem,6.6vw,5rem)] font-medium leading-[1.02] tracking-[-0.02em]">
          {HERO.headline}
        </h1>

        <p class="on-art-muted fade-in mx-auto mt-5 max-w-[34em] text-[17px] leading-relaxed">
          {HERO.lead}
        </p>

        <div class="fade-in mt-7 flex justify-center">
          <a
            href={DOWNLOAD_URL}
            data-track="download_click:dmg_hero"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>

        <button
          type="button"
          class="brew-line copy-btn fade-in mx-auto mt-5 flex max-w-full items-center gap-2 rounded-md px-2 py-1 font-mono text-[10.5px] text-white/85 transition-colors hover:text-white/95 sm:text-[12px]"
          data-copy={BREW_INSTALL}
          data-track="download_click:homebrew_hero"
          aria-label="Copy the Homebrew install command"
        >
          <span aria-hidden="true">$</span>
          {BREW_INSTALL}
          <span class="brew-state" aria-hidden="true"></span>
        </button>

        <p class="on-art-muted fade-in mt-4 text-[11px]">
          {HERO.requirements}
        </p>
      </div>
    </section>

    <!-- ── The bill ─────────────────────────── -->
    <!-- The page's thesis: what the alternatives cost in money, and that they
         cost your voice too. The chart is the one place other apps are named,
         and every figure in it is sourced on the line beneath it. -->
    <section class="px-6 pt-24 pb-20 md:pt-32 md:pb-28">
      <div class="mx-auto flex max-w-[62.5rem] flex-col gap-14">
        <div class="reveal flex flex-col items-center gap-5 text-center">
          <h2 class="font-display text-[clamp(2.25rem,5vw,3.5rem)] font-medium leading-[1.06] tracking-[-0.02em] text-balance">
            {PRICES.headline}
          </h2>
          <p class="max-w-[34em] text-lg leading-relaxed text-muted text-pretty">{PRICES.lead}</p>
        </div>

        <div
          class="reveal flex flex-col gap-8 rounded-[28px] border border-border bg-surface p-6 shadow-[0_30px_70px_-40px_rgba(18,35,61,0.35)] sm:p-10"
          data-cost-chart
        >
          <div class="flex flex-wrap items-center justify-between gap-5">
            <h3 class="text-[22px] font-medium">
              {PRICES.chartTitle}{" "}<span aria-live="polite" data-cost-period>{costPeriod(PRICE_YEARS[0])}</span>
            </h3>
            <!-- Hidden until the script runs: without it the chart shows one year
                 and a switch that does nothing would only mislead. -->
            <div role="group" aria-label="Period" class="inline-flex gap-1 rounded-full bg-[#eef3f9] p-1" data-cost-switch hidden>
              {PRICE_YEARS.map((years, i) => (
                <button
                  type="button"
                  class="btn-press rounded-full px-[18px] py-[9px] text-sm text-muted aria-pressed:bg-ink aria-pressed:text-white"
                  aria-pressed={i === 0 ? "true" : "false"}
                  data-years={years}
                >
                  {yearsLabel(years)}
                </button>
              ))}
            </div>
          </div>

          <ul class="flex flex-col gap-[22px]">
            {PLAN_PRICES.map((plan) => (
              <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-5 gap-y-2 sm:grid-cols-[11.5rem_minmax(0,1fr)_5.5rem]">
                <span class="text-[15px]">{plan.app}</span>
                <span
                  class="order-last col-span-2 block h-[18px] rounded-full bg-[#c9d6e6] sm:order-none sm:col-span-1"
                  style={`width: ${(plan.monthly / priciest) * 100}%`}
                  aria-hidden="true"
                ></span>
                <span class="text-right font-mono text-base tabular-nums" data-monthly={plan.monthly}>
                  {formatDollars(planCost(plan, PRICE_YEARS[0]))}
                </span>
              </li>
            ))}
            <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-5 gap-y-2 sm:grid-cols-[11.5rem_minmax(0,1fr)_5.5rem]">
              <span class="flex items-center gap-2 text-[15px] font-semibold">
                <img src="/suniye-icon.png" alt="" class="h-5 w-5 rounded-[4px]" />
                Suniye
              </span>
              <span class="order-last col-span-2 block h-[18px] w-[18px] rounded-full bg-accent sm:order-none sm:col-span-1" aria-hidden="true"></span>
              <span class="text-right font-mono text-base tabular-nums text-accent">{formatDollars(0)}</span>
            </li>
          </ul>

          <p class="text-xs leading-relaxed text-muted">{PRICES.source}</p>
        </div>
      </div>
    </section>

    <!-- ── Three claims, each with its proof ── -->
    <section class="border-y border-border bg-surface px-6 py-24 md:py-28">
      <div class="mx-auto grid max-w-6xl grid-cols-[repeat(auto-fit,minmax(min(20rem,100%),1fr))] gap-8">
        {CLAIMS.map((claim) => (
          <article class="reveal flex flex-col gap-[18px] py-2">
            <p class:list={[
              "font-mono text-xs uppercase tracking-[0.08em]",
              claim.tone === "fast" ? "text-fast-strong" : "text-accent",
            ]}>
              {claim.label}
            </p>
            <p class:list={[
              "font-display text-[52px] leading-none tracking-[-0.02em]",
              claim.tone === "fast" && "text-fast",
            ]}>
              {claim.figure}
            </p>
            <p class="text-[15px]">{claim.caption}</p>
            <p class="text-[15px] leading-relaxed text-muted">{claim.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Switching, habit to feature ──────── -->
    <section class="px-6 py-24 md:py-28">
      <div class="mx-auto flex max-w-[62.5rem] flex-col gap-12">
        <div class="reveal flex flex-col gap-3.5">
          <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] font-medium leading-[1.1] tracking-[-0.015em]">
            {SWITCHING.headline}
          </h2>
          <p class="max-w-[34em] text-[17px] leading-relaxed text-muted">{SWITCHING.lead}</p>
        </div>

        <ul class="reveal border-t border-border">
          {HABITS.map((h) => (
            <li class="grid grid-cols-1 items-center gap-x-4 gap-y-2 border-b border-border py-[22px] sm:grid-cols-[minmax(0,1fr)_2.5rem_minmax(0,1fr)]">
              <span class="font-display text-[22px]">{h.habit}</span>
              <svg class="hidden text-accent sm:block" width="28" height="12" viewBox="0 0 28 12" fill="none" aria-hidden="true">
                <path d="M1 6h24M20 1l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="flex flex-col gap-1">
                <span class="text-base font-medium">{h.feature}</span>
                <span class="text-sm text-muted">{h.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Closing ──────────────────────────── -->
    <!-- Book-ends the hero with the quieter dawn painting, so the page opens and
         closes on the same idea instead of trailing off into chrome. -->
    <section class="relative overflow-hidden bg-[#dfe9f4]">
      <picture>
        <source srcset="/band-dawn.webp" type="image/webp" />
        <img src="/band-dawn.jpg" alt="" loading="lazy" decoding="async" class="hero-art" />
      </picture>

      <div class="relative z-10 mx-auto max-w-6xl px-6 py-28 text-center md:py-36">
        <h2 class="on-art font-display text-3xl leading-snug tracking-tight md:text-5xl">
          {CLOSING}
        </h2>
        <div class="mt-8 flex justify-center">
          <a
            href={DOWNLOAD_URL}
            data-track="download_click:dmg_footer"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- ── Footer ─────────────────────────────── -->
  <Footer current="/" />

  <!-- ── Behaviour ──────────────────────────── -->
  <script>
    import { costPeriod, formatDollars } from "../lib/content/home";

    // Cross-fade the hero painting over its blurred placeholder once decoded.
    // complete === true covers the cached case, where load never fires.
    const heroArt = document.querySelector("[data-hero-art]");
    if (heroArt) {
      const settle = () => heroArt.classList.remove("is-loading");
      if (heroArt.complete) settle();
      else heroArt.addEventListener("load", settle, { once: true });
    }

    // The sky only belongs in the browser's chrome while the painting sits
    // under it: once the page below the hero scrolls into view, hand the canvas
    // back to the page colour, and take the sky again at the top. Observing the
    // first section with a small guard keeps the decision off the exact viewport
    // edge, where browsers disagree about zero-overlap intersections.
    const root = document.documentElement;
    const sky = root.style.getPropertyValue("--canvas-color").trim();
    const afterHero = document.getElementById("hero")?.nextElementSibling;
    if (sky && afterHero && "IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) root.style.removeProperty("--canvas-color");
          else root.style.setProperty("--canvas-color", sky);
        },
        { rootMargin: "0px 0px -8px 0px", threshold: 0 }
      ).observe(afterHero);
    }

    const revealEls = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      // No observer support — reveal everything rather than leave it hidden.
      revealEls.forEach((el) => el.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      revealEls.forEach((el) => observer.observe(el));

      // Backstop: if the observer has reported nothing after a second and a
      // half, show everything. A missing fade is invisible; missing content
      // is the whole page.
      setTimeout(() => {
        if (!document.querySelector(".reveal.visible")) {
          revealEls.forEach((el) => el.classList.add("visible"));
        }
      }, 1500);
    }

    // The price chart's period switch rewrites the amounts in place. The bars
    // keep their widths: every plan scales by the same number of years.
    const chart = document.querySelector("[data-cost-chart]");
    if (chart) {
      const period = chart.querySelector("[data-cost-period]");
      const amounts = chart.querySelectorAll<HTMLElement>("[data-monthly]");
      const buttons = chart.querySelectorAll<HTMLButtonElement>("[data-years]");
      const show = (years: number) => {
        amounts.forEach((amount) => {
          amount.textContent = formatDollars(Number(amount.dataset.monthly) * 12 * years);
        });
        if (period) period.textContent = costPeriod(years);
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(Number(button.dataset.years) === years));
        });
      };
      buttons.forEach((button) => button.addEventListener("click", () => show(Number(button.dataset.years))));
      chart.querySelector("[data-cost-switch]")?.removeAttribute("hidden");
    }

    // Copy the command associated with each copy button to the clipboard.
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.getAttribute("data-copy");
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 2000);
        } catch {
          // Clipboard API unavailable (e.g. insecure context) — fail silently.
        }
      });
    });
  </script>
</Layout>

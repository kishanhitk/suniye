---
import Layout from "../layouts/Layout.astro";
import CopyField from "../components/CopyField.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { softwareApplicationSchema, faqPageSchema, jsonLdString } from "../lib/seo";
import { BREW_INSTALL, DOWNLOAD_URL, GITHUB_URL, QUARANTINE_CMD } from "../lib/site";
import {
  HERO,
  CLOUD_PATH,
  LOCAL_PATH,
  ARGUMENT,
  INTERFACE,
  MODELS,
  MODELS_SECTION,
  CLEANUPS,
  MAGIC_FORMAT,
  TONES,
  SURFACES,
  WHERE_IT_WORKS,
  PROOF_POINTS,
  INSTALL,
  FAQS,
  CLOSING,
} from "../lib/content/home";

// Rendered on demand so the middleware can answer `Accept: text/markdown`
// with the page's Markdown variant; a prerendered page never reaches it.
export const prerender = false;
---

{/* iOS Safari paints the status-bar band above the page with the document's
    background colour, so over the painting it has to be the painting's own sky —
    sampled from the artwork at build time (astro.config.mjs), never pinned. */}
<Layout canvasColor={__HERO_SKY__}>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(softwareApplicationSchema())}
  />
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={jsonLdString(faqPageSchema(FAQS))}
  />
  <!-- Preload the same candidate set the <picture> will resolve, so the
       preloader fetches the tier this viewport actually needs rather than a
       fixed file it may then discard. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset="/hero-700.webp 700w, /hero-1100.webp 1100w, /hero-1672.webp 1672w"
    imagesizes="100vw"
    type="image/webp"
  />

  <Navbar variant="over-art" />

  <!-- With JS off, reveal-on-scroll never fires — show everything up front. -->
  <noscript>
    <style>
      .reveal, .js-reveal .reveal, .fade-in { opacity: 1 !important; transform: none !important; animation: none !important; }
    </style>
  </noscript>

  <main>
    <!-- ── Hero ─────────────────────────────── -->
    <!-- The painting is the page's whole first impression, so it is a real <img>
         (decoding early, preloaded) rather than a CSS background: the browser
         can then prioritise it as the LCP element. -->
    <section id="hero" class="hero-ground relative flex min-h-[100svh] flex-col overflow-hidden bg-[#2b6cc4]">
      <!-- An 853-byte blurred copy of the painting is inlined as the section's own
           background, so the first paint already has the right colour and shape
           under the headline. The real image fades over it once decoded — the
           browser picks the width. The ladder stops at 1672 because that is the
           painting's native size — anything wider is resampled, not sharper. -->
      <picture>
        <source
          srcset="
            /hero-700.webp   700w,
            /hero-1100.webp 1100w,
            /hero-1672.webp 1672w
          "
          sizes="100vw"
          type="image/webp"
        />
        <img
          src="/hero.jpg"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="hero-art is-loading"
          data-hero-art
        />
      </picture>

      <div class="relative z-10 mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-6 pt-24 pb-[48vh] text-center sm:pt-28 sm:pb-[38vh]">
        <h1 class="on-art font-display text-[clamp(2.75rem,6.6vw,5rem)] font-medium leading-[1.02] tracking-[-0.02em]">
          {HERO.headline}
        </h1>

        <p class="on-art-muted fade-in mx-auto mt-5 max-w-[34em] text-[17px] leading-relaxed">
          {HERO.lead}
        </p>

        <div class="fade-in mt-7 flex justify-center">
          <a
            href={DOWNLOAD_URL}
            data-dmg
            data-track="download_click:dmg_hero"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>

        <button
          type="button"
          class="brew-line copy-btn fade-in mx-auto mt-5 flex max-w-full items-center gap-2 rounded-md px-2 py-1 font-mono text-[10.5px] text-white/85 transition-colors hover:text-white/95 sm:text-[12px]"
          data-copy={BREW_INSTALL}
          data-track="download_click:homebrew_hero"
          aria-label="Copy the Homebrew install command"
        >
          <span aria-hidden="true">$</span>
          {BREW_INSTALL}
          <span class="brew-state" aria-hidden="true"></span>
        </button>

        <p class="on-art-muted fade-in mt-4 text-[11px]">
          {HERO.requirements}
        </p>
      </div>
    </section>

    <!-- ── The argument ─────────────────────── -->
    <!-- The page's thesis, and the only place set at lead size. The two paths are
         a real sequence, so they are numbered; the cloud column is deliberately
         the longer one, and the layout lets it read longer rather than squaring
         both columns into a symmetric pair. -->
    <section class="band relative overflow-hidden">
      <div class="bloom left-[6rem] top-[-8rem] h-[26rem] w-[42rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">The argument</p>
        <div>
          <h2 class="t-lead reveal">{ARGUMENT.headline}</h2>
          <p class="t-sub reveal">{ARGUMENT.lead}</p>

          <div class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-[0.85fr_1fr]">
            <div class="reveal">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted/60">
                Cloud dictation
              </p>
              <ol class="mt-5 space-y-3.5">
                {CLOUD_PATH.map((step, i) => (
                  <li class="flex items-baseline gap-3 text-[15px] text-muted">
                    <span class="font-mono text-[10px] tabular-nums text-muted/40">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    {step}
                  </li>
                ))}
              </ol>
              <p class="mt-6 max-w-[34ch] text-sm leading-relaxed text-muted/75">
                {ARGUMENT.cloudNote}
              </p>
            </div>

            <div class="reveal" style="transition-delay: 0.08s">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">
                Suniye
              </p>
              <ol class="mt-5 space-y-3.5">
                {LOCAL_PATH.map((step, i) => (
                  <li class="flex items-baseline gap-3 text-[15px] text-ink">
                    <span class="font-mono text-[10px] tabular-nums text-accent/50">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    {step}
                  </li>
                ))}
              </ol>
              <p class="mt-3 max-w-[34ch] text-sm leading-relaxed text-muted">
                {ARGUMENT.localNote}
              </p>

              <!-- The page's one warm mark: the measured number, lit like the dawn
                   edge of the painting above it. -->
              <div class="mt-8 border-t border-border pt-6">
                <p class="mark font-display text-[3.25rem] leading-none tracking-tight">
                  177<span class="ml-1 text-2xl text-muted">ms</span>
                </p>
                <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-muted">
                  {ARGUMENT.latencyNote}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Demo ─────────────────────────────── -->
    <!-- Click-to-play with sound: the narration is the point, and browsers block
         autoplay-with-audio, so we lead with a poster and a play affordance. -->
    <section class="band">
      <div class="band-inner">
        <p class="rail reveal">The whole interface</p>
        <div>
          <h2 class="t-head reveal">{INTERFACE.headline}</h2>
          <p class="t-sub reveal">{INTERFACE.lead}</p>

        <figure class="reveal mt-10" style="transition-delay: 0.1s">
          <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-[var(--shadow-float)]">
            <div class="flex items-center gap-1.5 border-b border-border/70 bg-surface/70 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
              <span class="ml-2.5 flex items-center gap-1.5 font-mono text-[11px] tracking-tight text-muted/70">
                <img src="/suniye-icon.png" alt="" class="h-3.5 w-3.5 rounded-[3px]" />
                Suniye
              </span>
            </div>

            <div class="relative bg-ink">
              <video
                id="demo-video"
                class="block w-full"
                poster="/demo-poster.jpg"
                preload="metadata"
                playsinline
                data-track-video
              >
                <source src="/demo.mp4" type="video/mp4" />
                Your browser can't play this video.
                <a href="/demo.mp4" class="underline">Download the demo</a> instead.
              </video>

              <!-- Live stopwatch, synced to the real playback clock -->
              <div
                id="demo-timer"
                class="pointer-events-none absolute right-3 top-3 z-20 rounded-md bg-ink/70 px-2.5 py-1 font-mono text-xs tabular-nums tracking-tight text-white backdrop-blur-sm"
                aria-hidden="true"
              >
                00:00.000
              </div>

              <button
                id="demo-play"
                type="button"
                class="demo-play group absolute inset-0 flex items-center justify-center bg-ink/25 transition-opacity duration-300"
                aria-label="Play the demo with sound"
              >
                <span
                  class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-accent text-white shadow-xl ring-1 ring-white/10 transition-transform duration-150 [transition-timing-function:var(--curve-out)] group-hover:scale-105 group-active:scale-95 md:h-[88px] md:w-[88px]"
                >
                  <svg class="h-7 w-7 translate-x-[2px] md:h-9 md:w-9" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 4.5l13 7.5-13 7.5z" />
                  </svg>
                </span>
              </button>
            </div>
          </div>

        </figure>
        </div>
      </div>
    </section>

    <!-- ── Cleanup, shown ───────────────────── -->
    <!-- Every competitor leads with a before/after because it is the only way to
         make "polished text" mean anything. Ours uses the eval suite so the
         right-hand column is behaviour we actually test for. -->
    <!-- Set as an actual transcript: the spoken line in mono at transcript grey,
         the written line directly beneath it in reading type. Stacking them
         vertically shows the transformation as one motion down the page; two
         side-by-side boxes made it a comparison of two separate things. -->
    <section class="band relative overflow-hidden">
      <div class="bloom left-[-10rem] top-[4rem] h-[24rem] w-[34rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">Magic Format</p>
        <div>
          <h2 class="t-head reveal">{MAGIC_FORMAT.headline}</h2>
          <p class="t-sub reveal">{MAGIC_FORMAT.lead}</p>

          <div class="mt-12 divide-y divide-border">
            {CLEANUPS.map((c, i) => (
              <div class="reveal py-8 first:pt-0">
                <p class="font-mono text-[13px] leading-relaxed text-muted/70">
                  {c.said}
                </p>
                <div class="mt-4 flex gap-4">
                  <span class="mt-2 h-px w-8 shrink-0 bg-accent/40" aria-hidden="true"></span>
                  <div>
                    <p class="whitespace-pre-line text-[17px] leading-relaxed text-ink">
                      {c.wrote}
                    </p>
                    <p class="mt-2.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted/50">
                      {c.label}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Anywhere, in the right register ──── -->
    <section class="band relative overflow-hidden">
      <div class="bloom right-[-10rem] top-[6rem] h-[22rem] w-[32rem]" aria-hidden="true"></div>
      <div class="band-inner relative z-10">
        <p class="rail reveal">Where it works</p>
        <div>
          <h2 class="t-head reveal">{WHERE_IT_WORKS.headline}</h2>
          <p class="t-sub reveal">{WHERE_IT_WORKS.lead}</p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-2.5" style="transition-delay: 0.08s">
          <kbd class="rounded-lg border border-white/70 bg-white/70 px-3 py-1.5 font-mono text-xs text-ink shadow-[0_1px_2px_rgba(18,35,61,0.06)] backdrop-blur-sm">
            fn
          </kbd>
          <span class="font-mono text-xs text-muted/60">hold &rarr;</span>
          {SURFACES.map((app) => (
            <span class="rounded-full border border-white/60 bg-white/50 px-3.5 py-1.5 text-[13px] text-muted backdrop-blur-sm">
              {app}
            </span>
          ))}
          <span class="text-[13px] text-muted/60">&hellip; and anywhere else you type</span>
        </div>

        <div class="reveal mt-20" style="transition-delay: 0.12s">
          <h3 class="t-head">{WHERE_IT_WORKS.tonesHeadline}</h3>
          <p class="t-sub">{WHERE_IT_WORKS.tonesLead}</p>
        </div>

        <div class="mt-10 divide-y divide-border border-t border-border">
          {TONES.map((t, i) => (
            <div
              class="reveal grid gap-x-8 gap-y-3 py-7 md:grid-cols-[7rem_1fr]"
             
            >
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">{t.app}</p>
                <p class="mt-2 text-[13px] leading-relaxed text-muted/75">{t.prompt}</p>
              </div>
              <p class="whitespace-pre-line text-[15px] leading-relaxed text-ink">{t.out}</p>
            </div>
          ))}
        </div>

        </div>
      </div>
    </section>

    <!-- ── Models ───────────────────────────── -->
    <!-- The choice is the selling point; the catalogue is reference, so it stays
         folded until someone actually wants to compare sizes. -->
    <section id="models" class="band scroll-mt-20 bg-[linear-gradient(180deg,rgba(43,108,196,0.05),transparent)]">
      <div class="band-inner">
        <p class="rail reveal">Speech models</p>
        <div>
          <h2 class="t-head reveal">{MODELS_SECTION.headline}</h2>
          <p class="t-sub reveal">{MODELS_SECTION.lead}</p>

          <ul class="reveal mt-10 divide-y divide-border border-t border-border" style="transition-delay: 0.08s">
            {[MODELS[0], MODELS[1], MODELS[7]].map((m) => (
              <li class="grid gap-x-6 gap-y-1 py-4 md:grid-cols-[13rem_1fr_5rem]">
                <span class="flex items-center gap-2 text-[15px] tracking-tight text-ink">
                  {m.name}
                  {m.tag && <span class="pill pill-accent">{m.tag}</span>}
                </span>
                <span class="text-sm text-muted/80">{m.langs}</span>
                <span class="font-mono text-xs text-muted/60 md:text-right">{m.size}</span>
              </li>
            ))}
          </ul>

        <details class="reveal group mt-8" style="transition-delay: 0.1s" data-track-open="models_list">
          <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-white px-5 py-2.5 font-mono text-[11px] tracking-wide text-muted transition-colors [&::-webkit-details-marker]:hidden hover:text-ink">
            <span class="group-open:hidden">And nine more</span>
            <span class="hidden group-open:inline">Hide the list</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-200 [transition-timing-function:var(--curve-out)] group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <ul class="mt-8 divide-y divide-border border-t border-border">
            {MODELS.filter((_, i) => ![0, 1, 7].includes(i)).map((m) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3.5">
                <span class="text-[15px] tracking-tight text-ink">{m.name}</span>
                {m.tag && <span class="pill pill-accent">{m.tag}</span>}
                <span class="ml-auto font-mono text-xs text-muted/70">{m.size}</span>
                <span class="w-full text-sm text-muted/80">{m.langs}</span>
              </li>
            ))}
          </ul>
        </details>
        </div>
      </div>
    </section>

    <!-- ── Proof ────────────────────────────── -->
    <!-- Deliberately not stars or download counts: at this stage those numbers
         argue against the app. Shipping cadence is the honest signal that an
         alpha is alive, and it is checkable on the releases page. -->
    <section class="border-y border-border bg-white/50 py-7">
      <div class="mx-auto max-w-6xl px-6">
        <!-- One column on phones: the dot separators only make sense while the
             items share a line, and wrapping strands them at the ends of rows. -->
        <ul class="reveal flex flex-col items-center gap-y-2.5 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-muted/70 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-8 sm:gap-y-3">
          <li>{PROOF_POINTS[0]}</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>
            <a
              href={`${GITHUB_URL}/releases`}
              target="_blank"
              rel="noopener"
              class="transition-colors hover:text-ink"
            >
              {PROOF_POINTS[1]}
            </a>
          </li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>{PROOF_POINTS[2]}</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>{PROOF_POINTS[3]}</li>
          <li aria-hidden="true" class="hidden text-muted/25 sm:block">&middot;</li>
          <li>{PROOF_POINTS[4]}</li>
        </ul>
      </div>
    </section>

    <!-- ── Install ──────────────────────────── -->
    <section id="install" class="band scroll-mt-20 border-t-0">
      <div class="band-inner">
        <p class="rail reveal">Install</p>
        <div class="reveal max-w-xl">
          <h2 class="t-head">{INSTALL.headline}</h2>

          <div class="mt-8">
            <div class="mb-2 flex items-center gap-2">
              <span class="font-mono text-xs uppercase tracking-widest text-muted">
                Homebrew
              </span>
              <span class="pill pill-accent">Recommended</span>
            </div>
            <CopyField
              value={BREW_INSTALL}
              label="Copy install command"
              dataTrack="download_click:homebrew"
            />
            <p class="mt-3 text-sm leading-relaxed text-muted/80">
              {INSTALL.brewNote}
            </p>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={DOWNLOAD_URL}
              data-dmg
              data-track="download_click:dmg_install"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm text-ink hover:bg-surface"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3" />
              </svg>
              Download .dmg
            </a>
            <a
              href={`${GITHUB_URL}#build-from-source`}
              target="_blank"
              rel="noopener"
              class="btn-press inline-flex items-center gap-2 rounded-lg border border-border px-7 py-3.5 text-sm text-ink hover:bg-surface"
            >
              Build from source
            </a>
          </div>

          <p class="mt-8 text-sm leading-relaxed text-muted/80">
            {INSTALL.requirements}
          </p>

          <p class="mt-6">
            <span class="pill pill-accent">{INSTALL.status}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────── -->
    <section id="faq" class="band scroll-mt-20 bg-[linear-gradient(180deg,transparent,rgba(43,108,196,0.05))]">
      <div class="band-inner">
        <p class="rail reveal">Questions</p>
        <div>
          <div class="reveal divide-y divide-border border-y border-border" style="transition-delay: 0.1s">
            {FAQS.map((item) => (
              <details class="faq-item group" data-track-open={`faq_${item.q.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "").slice(0, 40)}`}>
                <summary class="flex items-center justify-between gap-4 py-5">
                  <span class="text-base tracking-tight text-ink">{item.q}</span>
                  <span class="faq-sign shrink-0 text-xl leading-none text-accent">+</span>
                </summary>
                <p class="max-w-[62ch] pb-5 text-[15px] leading-relaxed text-muted">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Closing ──────────────────────────── -->
    <!-- Book-ends the hero with the quieter dawn painting, so the page opens and
         closes on the same idea instead of trailing off into chrome. -->
    <section class="relative overflow-hidden bg-[#dfe9f4]">
      <picture>
        <source srcset="/band-dawn.webp" type="image/webp" />
        <img src="/band-dawn.jpg" alt="" loading="lazy" decoding="async" class="hero-art" />
      </picture>

      <div class="relative z-10 mx-auto max-w-6xl px-6 py-28 text-center md:py-36">
        <h2 class="on-art font-display text-3xl leading-snug tracking-tight md:text-5xl">
          {CLOSING}
        </h2>
        <div class="mt-8 flex justify-center">
          <a
            href={DOWNLOAD_URL}
            data-dmg
            data-track="download_click:dmg_footer"
            class="glass inline-flex items-center gap-2 px-6 py-3 text-[15px] font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.47 2.2-1.22 2.98-.79.83-2.05 1.47-3.11 1.38-.13-1.1.42-2.25 1.15-3.02.8-.84 2.16-1.45 3.18-1.34zM20.7 17.02c-.55 1.26-.81 1.82-1.52 2.94-.99 1.55-2.39 3.48-4.12 3.5-1.54.01-1.93-1-4.02-.99-2.09.01-2.52 1.01-4.06.99-1.73-.02-3.06-1.76-4.05-3.31C.16 15.8-.13 10.7 1.55 8.03c1.18-1.9 3.05-3.01 4.8-3.01 1.79 0 2.91 1 4.39 1 1.43 0 2.3-1 4.37-1 1.57 0 3.23.85 4.42 2.32-3.88 2.13-3.25 7.68 1.17 9.68z" />
            </svg>
            Download for macOS
          </a>
        </div>
      </div>
    </section>

    <!-- ── Quarantine notice — surfaced after a .dmg download ─ -->
    <div
      id="dmg-banner"
      class="dmg-modal fixed inset-0 z-[70] flex items-center justify-center px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dmg-title"
      hidden
    >
      <div class="dmg-scrim absolute inset-0 bg-ink/55 backdrop-blur-md" data-dmg-close></div>

      <div class="dmg-card relative w-full max-w-2xl overflow-hidden rounded-2xl border border-white/70 bg-bg shadow-[0_50px_120px_-24px_rgba(16,40,68,0.55)]">
        <div class="p-7 md:p-8">
          <div class="flex items-start gap-4">
            <div class="flex-1">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted/60">
                One-time step
              </p>
              <p id="dmg-title" class="mt-2 font-display text-2xl leading-tight tracking-tight text-ink">
                If macOS says the app is damaged
              </p>
            </div>
            <button
              id="dmg-banner-close"
              type="button"
              class="btn-press -mr-1.5 -mt-1.5 flex-none rounded-lg p-2 text-muted/50 hover:bg-surface hover:text-ink"
              aria-label="Dismiss"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-muted">
            It isn't. Suniye isn't signed with a paid Apple Developer certificate,
            so macOS quarantines the download. This clears it:
          </p>

          <!-- The command reads as a terminal line, not a form field: dark ground,
               mono, and the only thing in the dialog with any weight. -->
          <div class="mt-5 flex items-center gap-3 rounded-xl bg-ink px-4 py-3.5">
            <code class="flex-1 break-all font-mono text-[12.5px] leading-relaxed text-white/90">
              {QUARANTINE_CMD}
            </code>
            <button
              class="copy-btn btn-press relative flex-none rounded-md p-1.5 text-white/50 hover:bg-white/10 hover:text-white"
              data-copy={QUARANTINE_CMD}
              aria-label="Copy the command"
            >
              <svg class="copy-icon h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
              </svg>
              <svg class="check-icon h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>

          <p class="mt-3 text-[13px] leading-relaxed text-muted/75">
            Paste it into Terminal after dragging Suniye to Applications, then open
            the app as usual.
          </p>
        </div>

        <!-- Homebrew avoids the whole thing, so it belongs here rather than buried
             further down the page. Deliberately quieter than the xattr block
             above: light ground, muted ink, no terminal styling — an alternative
             for next time, not a second instruction competing with the fix. -->
        <div class="border-t border-border bg-surface/70 px-7 py-5 md:px-8">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
            <div class="min-w-0 flex-1">
              <p class="text-[13px] leading-relaxed text-muted">
                Or install with Homebrew, which clears this for you.
              </p>
              <button
                class="copy-btn btn-press relative mt-2 flex w-full items-center gap-2 rounded-lg border border-border bg-bg px-3 py-2 text-left"
                data-copy={BREW_INSTALL}
                data-track="download_click:homebrew_modal"
                aria-label="Copy the Homebrew install command"
              >
                <code class="min-w-0 flex-1 break-all font-mono text-[12px] text-muted">
                  {BREW_INSTALL}
                </code>
                <span class="relative h-3.5 w-3.5 flex-none text-muted/50">
                  <svg class="copy-icon h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
                  </svg>
                  <svg class="check-icon h-3.5 w-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
              </button>
            </div>

            <button
              type="button"
              data-dmg-close
              class="btn-press rounded-lg bg-ink px-5 py-2.5 text-sm text-bg hover:bg-ink/85"
            >
              Got it
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- ── Footer ─────────────────────────────── -->
  <Footer current="/" />

  <!-- ── Behaviour ──────────────────────────── -->
  <script>
    // Cross-fade the hero painting over its blurred placeholder once decoded.
    // complete === true covers the cached case, where load never fires.
    const heroArt = document.querySelector("[data-hero-art]");
    if (heroArt) {
      const settle = () => heroArt.classList.remove("is-loading");
      if (heroArt.complete) settle();
      else heroArt.addEventListener("load", settle, { once: true });
    }

    // The sky only belongs in the browser's chrome while the painting sits
    // under it: once the page below the hero scrolls into view, hand the canvas
    // back to the page colour, and take the sky again at the top. Observing the
    // first section with a small guard keeps the decision off the exact viewport
    // edge, where browsers disagree about zero-overlap intersections.
    const root = document.documentElement;
    const sky = root.style.getPropertyValue("--canvas-color").trim();
    const afterHero = document.getElementById("hero")?.nextElementSibling;
    if (sky && afterHero && "IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) root.style.removeProperty("--canvas-color");
          else root.style.setProperty("--canvas-color", sky);
        },
        { rootMargin: "0px 0px -8px 0px", threshold: 0 }
      ).observe(afterHero);
    }

    const revealEls = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      // No observer support — reveal everything rather than leave it hidden.
      revealEls.forEach((el) => el.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      revealEls.forEach((el) => observer.observe(el));

      // Backstop: if the observer has reported nothing after a second and a
      // half, show everything. A missing fade is invisible; missing content
      // is the whole page.
      setTimeout(() => {
        if (!document.querySelector(".reveal.visible")) {
          revealEls.forEach((el) => el.classList.add("visible"));
        }
      }, 1500);
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Demo video: click the poster overlay to play with sound and native controls,
    // and run a stopwatch read from the real playback clock. Under reduced motion
    // we drop the 60fps millisecond repaint and tick on the video's own updates.
    const demoVideo = document.getElementById("demo-video");
    const demoPlay = document.getElementById("demo-play");
    const demoTimer = document.getElementById("demo-timer");
    if (demoVideo && demoPlay) {
      const fmt = (t) => {
        const base =
          String(Math.floor(t / 60)).padStart(2, "0") + ":" +
          String(Math.floor(t % 60)).padStart(2, "0");
        if (reduceMotion) return base;
        return base + "." + String(Math.floor((t % 1) * 1000)).padStart(3, "0");
      };
      const render = () => {
        if (demoTimer) demoTimer.textContent = fmt(demoVideo.currentTime);
      };
      let raf = 0;
      const tick = () => {
        render();
        raf = requestAnimationFrame(tick);
      };
      render();
      demoVideo.addEventListener("play", () => {
        if (reduceMotion) return;
        cancelAnimationFrame(raf);
        tick();
      });
      demoVideo.addEventListener("pause", () => {
        cancelAnimationFrame(raf);
        render();
      });
      demoVideo.addEventListener("seeked", render);
      if (reduceMotion) demoVideo.addEventListener("timeupdate", render);
      demoPlay.addEventListener("click", () => {
        demoVideo.controls = true;
        demoPlay.classList.add("is-playing");
        demoVideo.play().catch(() => {
          demoPlay.classList.remove("is-playing");
          demoVideo.controls = false;
        });
      });
      demoVideo.addEventListener("ended", () => {
        cancelAnimationFrame(raf);
        render();
        demoVideo.controls = false;
        demoPlay.classList.remove("is-playing");
      });
    }

    // Surface the quarantine notice once the user grabs the app directly.
    // As an aria-modal dialog it owns focus while open: move focus in, trap Tab,
    // lock body scroll, and restore focus to the trigger on close.
    const dmgBanner = document.getElementById("dmg-banner");
    if (dmgBanner) {
      const card = dmgBanner.querySelector(".dmg-card");
      const closeEl = document.getElementById("dmg-banner-close");
      let lastFocused = null;
      const openDmg = () => {
        lastFocused = document.activeElement;
        dmgBanner.hidden = false;
        document.body.style.overflow = "hidden";
        closeEl?.focus();
      };
      const closeDmg = () => {
        dmgBanner.hidden = true;
        document.body.style.overflow = "";
        lastFocused?.focus?.();
      };
      document.querySelectorAll("[data-dmg]").forEach((el) => {
        el.addEventListener("click", openDmg);
      });
      dmgBanner
        .querySelectorAll("[data-dmg-close], #dmg-banner-close")
        .forEach((el) => el.addEventListener("click", closeDmg));
      document.addEventListener("keydown", (e) => {
        if (dmgBanner.hidden) return;
        if (e.key === "Escape") {
          closeDmg();
        } else if (e.key === "Tab" && card) {
          const items = card.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Copy the command associated with each copy button to the clipboard.
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text =
          btn.getAttribute("data-copy") ||
          btn.parentElement?.querySelector("code")?.textContent?.trim() ||
          "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 2000);
        } catch {
          // Clipboard API unavailable (e.g. insecure context) — fail silently.
        }
      });
    });
  </script>
</Layout>

---
import "../styles/global.css";
import Beacon from "../components/Beacon.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "Suniye — Private Dictation for macOS",
  description = "Open-source, local-first dictation for macOS. Hold one key, speak, and your words appear at your cursor. Choose from 11 on-device speech models, with optional AI cleanup that can run entirely on your Mac. No audio leaves your machine.",
  canonicalPath = "/",
} = Astro.props;

const siteUrl = "https://suniye.app";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" type="image/png" href="/suniye-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://suniye.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://suniye.app/og-image.png" />
  </head>
  <body class="min-w-[320px] bg-bg font-body text-ink antialiased">
    <slot />
    <Beacon />
  </body>
</html>
